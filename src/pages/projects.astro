      async function deleteCurrentTask() {
        const task = (state.detail?.tasks || []).find((item) => item.id === state.editingTaskId);
        if (!task || !state.selectedProjectId) return;
        const meeting = isMeetingTask(task);
        const button = document.getElementById('delete-task');
        const message = document.getElementById('task-form-message');
        if (!state.taskDeleteArmed) {
          state.taskDeleteArmed = true;
          button.textContent = 'Confirmar eliminación';
          message.textContent = `${meeting ? 'La reunión' : 'La tarea'} se quitará del plan y de la vista compartida. Su historial se conservará.`;
          return;
        }
        button.disabled = true;
        button.textContent = 'Eliminando…';
        try {
          await projectRequest('', {
            method: 'POST',
            body: JSON.stringify({
              action: 'delete_task',
              project_id: state.selectedProjectId,
              task_id: task.id,
              version: task.version,
            }),
          });
          const projectId = state.selectedProjectId;
          closeTaskModal();
          await loadProjects(projectId);
          setSyncStatus(`${meeting ? 'Reunión' : 'Tarea'} eliminada`, true);
        } catch (error) {
          state.taskDeleteArmed = false;
          button.disabled = false;
          button.textContent = meeting ? 'Eliminar reunión' : 'Eliminar tarea';
          message.textContent = error.message;
        }
      }

