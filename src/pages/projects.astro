    <div id="departments-modal" class="pm-modal-backdrop pm-hidden" role="dialog" aria-modal="true" aria-labelledby="departments-modal-title">
      <div class="pm-modal" style="max-width:920px">
        <div class="pm-modal-head"><div><h2 id="departments-modal-title">Gestionar departamentos</h2><p>Crea, renombra o desactiva departamentos sin romper proyectos ni plantillas.</p></div><button id="close-departments-modal" class="pm-button pm-button-quiet" type="button" aria-label="Cerrar">×</button></div>
        <div class="pm-modal-body">
          <form id="create-department-form" class="pm-form-grid">
            <div class="pm-field"><label for="new-department-name">Nuevo departamento</label><input id="new-department-name" class="pm-input" maxlength="120" placeholder="Ej. Ilustración" required></div>
            <div class="pm-field"><label for="new-department-color">Color</label><div style="display:flex;gap:8px;align-items:center"><input id="new-department-color" class="pm-color-input" type="color" value="#72BEC7"><button id="create-department" class="pm-button pm-button-primary" type="submit">Crear departamento</button></div></div>
          </form>
          <div id="department-management-list" class="pm-department-manager"></div>
          <p id="department-management-message" class="pm-form-message" role="status"></p>
        </div>
        <div class="pm-modal-actions"><button id="done-departments-modal" class="pm-button pm-button-primary" type="button">Listo</button></div>
      </div>
