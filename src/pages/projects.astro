      function syncTaskCompletion(source) {
        const status = document.getElementById('task-status');
        const progress = document.getElementById('task-progress');
        let progressValue = Math.max(0, Math.min(100, Number(progress.value || 0)));
        if (source === 'status' && status.value === 'completed') progressValue = 100;
        if (source === 'progress') {
          if (progressValue >= 100 && status.value !== 'cancelled') status.value = 'completed';
          else if (status.value === 'completed') status.value = progressValue > 0 ? 'in_progress' : 'not_started';
          else if (progressValue > 0 && ['not_started', 'ready'].includes(status.value)) status.value = 'in_progress';
        }
        progress.value = Math.round(progressValue);
        refreshCustomSelect(status);
      }

