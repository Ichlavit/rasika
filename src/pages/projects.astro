      function renderMeetingCalendarEvent(task) {
        const event = state.editingMeetingEvent;
        const eventUrl = safeExternalUrl(event?.event_url);
        document.getElementById('meeting-calendar-event').innerHTML = `<div class="pm-calendar-row"><span class="pm-hours-badge">1×</span><span class="pm-calendar-copy"><strong>${escapeHTML(task.title)}</strong><span>${event?.event_id ? 'Evento vinculado · una reunión, un evento' : 'Crea un Meet nuevo o vincula una reunión existente sin duplicarla'}</span></span><span class="pm-calendar-schedule"><input id="meeting-event-start" class="pm-input pm-input-compact" type="datetime-local" value="${escapeHTML(event?.starts_at || '')}" ${event?.event_id ? 'disabled' : ''} aria-label="Fecha y hora de reunión"><input id="meeting-duration" class="pm-input pm-input-compact" type="number" min="15" max="1440" step="15" value="${escapeHTML(event?.duration_minutes || 60)}" ${event?.event_id ? 'disabled' : ''} aria-label="Duración de reunión en minutos"></span><span class="pm-calendar-actions-stack">${eventUrl ? `<a class="pm-button pm-button-quiet pm-input-compact pm-link-button" href="${escapeHTML(eventUrl)}" target="_blank" rel="noopener">Abrir evento</a>` : '<button id="create-meeting-event" class="pm-button pm-button-quiet pm-input-compact" type="button">Crear Meet e invitar</button><button id="link-existing-meeting-event" class="pm-button pm-button-quiet pm-input-compact" type="button">Vincular existente</button>'}</span></div>`;
