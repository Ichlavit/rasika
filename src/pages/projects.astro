          setSyncStatus('Sin conexión');
          state.detail = null;
          renderMetrics();
          renderProjectList();
          renderWorkspace();
          document.getElementById('timeline-panel').innerHTML = `<div class="pm-empty"><strong>La base está preparada, pero aún no está desplegada</strong><p>${escapeHTML(error.message)}. Revisa el archivo de accesos pendientes antes de aplicar la migración y la función.</p></div>`;
