      document.getElementById('task-edit-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const task = (state.detail?.tasks || []).find((item) => item.id === state.editingTaskId);
        if (!task || !state.selectedProjectId) return;
        const meeting = isMeetingTask(task);
        const message = document.getElementById('task-form-message');
        const submit = document.getElementById('submit-task-edit');
        const plannedStart = document.getElementById('task-start').value || null;
        const plannedEnd = meeting ? plannedStart : (document.getElementById('task-end').value || null);
        const forecastStart = meeting ? null : (document.getElementById('task-forecast-start').value || null);
        const forecastEnd = meeting ? null : (document.getElementById('task-forecast-end').value || null);
        if (!meeting && plannedStart && plannedEnd && plannedEnd < plannedStart) {
          message.textContent = 'La fecha de término no puede ser anterior al inicio.';
          return;
        }
        if (!meeting && forecastStart && forecastEnd && forecastEnd < forecastStart) {
          message.textContent = 'El término previsto no puede ser anterior al inicio previsto.';
          return;
        }
        message.textContent = '';
        submit.disabled = true;
        submit.textContent = 'Guardando…';
        try {
          const commonUpdate = {
            title: document.getElementById('task-title').value,
            department_id: document.getElementById('task-department').value,
            status: document.getElementById('task-status').value,
            planned_start: plannedStart,
            planned_end: plannedEnd,
            description: document.getElementById('task-description').value,
          };
          const taskUpdate = meeting ? {
            ...commonUpdate,
            calendar_event: {
              ...state.editingMeetingEvent,
              duration_minutes: Math.round(Number(state.editingMeetingEvent?.duration_minutes || 60)),
              status: document.getElementById('task-status').value,
            },
            meeting_details: {
              attendees: collectMeetingPeople('meeting-attendees'),
              responsible_people: collectMeetingPeople('meeting-responsibles'),
              commitments: collectMeetingCommitments(),
            },
          } : {
            ...commonUpdate,
            progress: document.getElementById('task-progress').value,
            forecast_start: forecastStart,
            forecast_end: forecastEnd,
            planned_effort_minutes: Math.round(Number(document.getElementById('task-effort').value || 0) * 60),
            actual_effort_minutes: Math.round(Number(document.getElementById('task-actual-effort').value || 0) * 60),
            client_visible: document.getElementById('task-client-visible').checked,
            required_inputs: [...document.querySelectorAll('#task-required-inputs [data-required-input-id]')].map((row) => ({
              id: row.dataset.requiredInputId,
              label: row.querySelector('[data-required-input-label]').value.trim(),
              completed: row.querySelector('[data-required-input-check]').checked,
            })).filter((item) => item.label),
            tags: document.getElementById('task-tags').value.split(',').map((value) => value.trim()).filter(Boolean),
            linked_document_ids: [...document.querySelectorAll('input[name="task-document"]:checked')].map((input) => input.value),
            calendar_blocks: state.editingCalendarBlocks,
          };
          await projectRequest('', {
            method: 'POST',
            body: JSON.stringify({
              action: 'update_task',
              project_id: state.selectedProjectId,
              task_id: task.id,
              version: task.version,
              task: taskUpdate,
            }),
          });
          closeTaskModal();
          await selectProject(state.selectedProjectId);
          setSyncStatus('Cambios guardados', true);
        } catch (error) {
          message.textContent = error.message;
        } finally {
          submit.disabled = false;
          submit.textContent = 'Guardar cambios';
        }
      });

