    <script is:inline>
      const projectConfig = document.getElementById('projects-config');
      const SUPABASE_URL = String(projectConfig?.dataset.url || '').replace(/\/$/, '');
      const SUPABASE_KEY = String(projectConfig?.dataset.key || '');
      const state = {
        bootstrap: null,
        detail: null,
        selectedProjectId: null,
        createKey: null,
        editingTaskId: null,
        listSort: 'department',
        listDirection: 'asc',
        collapsedDepartments: new Set(),
        collapsedDriveFolders: new Set(),
        editingCalendarBlocks: [],
        editingMeetingEvent: null,
        editingMeetingAttendees: [],
        editingMeetingResponsibles: [],
        editingMeetingCommitments: [],
        calendarLinkContext: null,
        activeShareLinkId: null,
        taskDeleteArmed: false,
        selectedTimelineTaskIds: new Set(),
        timelineDrag: null,
        timelineZoom: 1,
        timelineBaseWidth: null,
      };

      function escapeHTML(value) {
        return String(value ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function formatDate(value) {
        if (!value) return 'Sin fecha';
        const date = new Date(`${value}T12:00:00`);
        return new Intl.DateTimeFormat('es-CL', { day: '2-digit', month: 'short', year: 'numeric' }).format(date);
      }

      function formatTimestamp(value) {
        if (!value) return 'Sin fecha de modificación';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return 'Sin fecha de modificación';
        return `Modificado ${new Intl.DateTimeFormat('es-CL', { day: '2-digit', month: 'short', year: 'numeric' }).format(date)}`;
      }

      function formatCalendarDateTime(value) {
        if (!value) return 'Sin fecha';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return String(value);
        return new Intl.DateTimeFormat('es-CL', { weekday: 'short', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }).format(date);
      }

      function statusLabel(value) {
        return ({ draft: 'Borrador', planned: 'Planificado', active: 'Activo', on_hold: 'En pausa', completed: 'Completado', cancelled: 'Cancelado' })[value] || value || 'Sin estado';
      }

      function taskStatusLabel(value) {
        return ({
          not_started: 'No iniciada',
          ready: 'Lista',
          in_progress: 'En curso',
          blocked: 'Bloqueada',
          in_review: 'En revisión',
          completed: 'Completada',
          cancelled: 'Cancelada',
        })[value] || value || 'Sin estado';
      }

      function meetingStatusLabel(value) {
        return ({ not_started: 'Programada', in_progress: 'En curso', completed: 'Realizada', cancelled: 'Cancelada' })[value] || value || 'Sin estado';
      }

      function calendarStatusLabel(value) {
        return ({ not_started: 'No iniciado', in_progress: 'En curso', completed: 'Completo' })[value] || 'No iniciado';
      }

      function closeCustomSelects(except = null) {
        document.querySelectorAll('.pm-select.is-open').forEach((element) => {
          if (element !== except) element.classList.remove('is-open');
        });
      }

      function refreshCustomSelect(select) {
        const wrapper = select?.closest('.pm-select');
        if (!wrapper) return;
        const button = wrapper.querySelector('.pm-select-button');
        const menu = wrapper.querySelector('.pm-select-menu');
        const options = [...select.options];
        const selected = options.find((option) => option.value === select.value) || options[0];
        button.querySelector('span').textContent = selected?.textContent || 'Seleccionar';
        menu.innerHTML = options.map((option) => `<button class="pm-select-option ${option.value === select.value ? 'is-selected' : ''}" type="button" data-select-value="${escapeHTML(option.value)}">${escapeHTML(option.textContent)}</button>`).join('');
        menu.querySelectorAll('[data-select-value]').forEach((optionButton) => {
          optionButton.addEventListener('click', () => {
            select.value = optionButton.dataset.selectValue;
            select.dispatchEvent(new Event('input', { bubbles: true }));
            select.dispatchEvent(new Event('change', { bubbles: true }));
            refreshCustomSelect(select);
            wrapper.classList.remove('is-open');
          });
        });
      }

      function enhanceSelect(select) {
        if (!select || select.dataset.enhanced === 'true') {
          refreshCustomSelect(select);
          return;
        }
        const compact = select.classList.contains('pm-input-compact');
        const wrapper = document.createElement('div');
        wrapper.className = `pm-select${compact ? ' pm-input-compact' : ''}`;
        select.parentNode.insertBefore(wrapper, select);
        wrapper.appendChild(select);
        select.classList.add('pm-native-select');
        select.dataset.enhanced = 'true';
        wrapper.insertAdjacentHTML('beforeend', `<button class="pm-select-button" type="button" aria-haspopup="listbox" aria-expanded="false"><span></span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></button><div class="pm-select-menu" role="listbox"></div>`);
        const button = wrapper.querySelector('.pm-select-button');
        button.addEventListener('click', () => {
          const willOpen = !wrapper.classList.contains('is-open');
          closeCustomSelects(wrapper);
          wrapper.classList.toggle('is-open', willOpen);
          button.setAttribute('aria-expanded', String(willOpen));
        });
        select.addEventListener('change', () => refreshCustomSelect(select));
        refreshCustomSelect(select);
      }

      function safeDepartmentColor(value) {
        return /^#[0-9a-f]{6}$/i.test(String(value || '')) ? value : '#8f999f';
      }

      function isMeetingTask(task) {
        return task?.metadata?.task_type === 'meeting' || /(^|:)weekly_meeting_|(^|:)kickoff$/.test(String(task?.task_key || '')) || /reuni[oó]n|kick-off/i.test(String(task?.title || ''));
      }

      function currentToken() {
        const token = sessionStorage.getItem('adminToken');
        return token && token.split('.').length === 3 ? token : '';
      }

      async function projectRequest(path = '?resource=bootstrap', options = {}) {
        const token = currentToken();
        if (!token) throw new Error('Tu sesión expiró. Ingresa nuevamente.');
        const response = await fetch(`${SUPABASE_URL}/functions/v1/project-admin${path}`, {
          ...options,
          headers: {
            'Content-Type': 'application/json',
            apikey: SUPABASE_KEY,
            Authorization: `Bearer ${token}`,
            ...(options.headers || {}),
          },
        });
        const result = await response.json().catch(() => ({}));
        if (response.status === 401) logoutProjects();
        if (!response.ok) throw new Error(result.error || `Error de proyectos (${response.status})`);
        return result;
      }

      function replaceTaskState(updatedTask) {
        if (!updatedTask?.id || !state.detail?.tasks) return;
        const index = state.detail.tasks.findIndex((task) => task.id === updatedTask.id);
        if (index >= 0) state.detail.tasks[index] = updatedTask;
      }

      function showProjectsApp() {
        document.getElementById('projects-auth').classList.add('pm-hidden');
        document.getElementById('projects-app').classList.remove('pm-hidden');
      }

      function showProjectsLogin() {
        document.getElementById('projects-app').classList.add('pm-hidden');
        document.getElementById('projects-auth').classList.remove('pm-hidden');
      }

      function logoutProjects() {
        sessionStorage.removeItem('adminToken');
        state.bootstrap = null;
        state.detail = null;
        showProjectsLogin();
      }

      function setSyncStatus(label, ready = false) {
        const element = document.getElementById('sync-status');
        element.classList.toggle('is-ready', ready);
        element.querySelector('span:last-child').textContent = label;
      }

      function renderMetrics() {
        const metrics = state.bootstrap?.metrics || {};
        const items = [
          ['Proyectos totales', metrics.total_projects || 0],
          ['En curso', metrics.active_projects || 0],
          ['Fuera de fecha', metrics.overdue_projects || 0],
          ['Servicios con plantilla', metrics.services_with_active_blueprints || 0],
        ];
        document.getElementById('project-metrics').innerHTML = items.map(([label, value]) => `
          <article class="pm-metric"><span>${escapeHTML(label)}</span><strong>${escapeHTML(value)}</strong></article>
        `).join('');
      }

      function renderProjectList() {
        const projects = state.bootstrap?.projects || [];
        const list = document.getElementById('project-list');
        if (!projects.length) {
          list.innerHTML = '<div class="pm-empty" style="padding:22px 8px"><p>Aún no hay proyectos.</p></div>';
          return;
        }
        list.innerHTML = projects.map((project) => {
          const organization = project.organization || {};
          return `
            <button type="button" class="pm-project-item ${project.id === state.selectedProjectId ? 'is-active' : ''}" data-project-id="${escapeHTML(project.id)}">
              <strong>${escapeHTML(project.name)}</strong>
              <span><span>${escapeHTML(project.project_code)}</span><span>${escapeHTML(statusLabel(project.status))}</span></span>
              <span class="pm-project-client">${escapeHTML(organization.display_name || organization.legal_name || 'Cliente')}</span>
              <span class="pm-project-short">${escapeHTML(String(project.project_code || 'P').split('-').at(-1))}</span>
            </button>`;
        }).join('');
        list.querySelectorAll('[data-project-id]').forEach((button) => {
          button.addEventListener('click', () => selectProject(button.dataset.projectId));
        });
      }

      function renderProjectHeading() {
        const project = state.detail?.project;
        const heading = document.getElementById('project-heading');
        if (!project) {
          heading.innerHTML = `
            <div><span class="pm-eyebrow">Primer slice</span><h2>Planificación conectada al catálogo</h2>
            <div class="pm-project-meta"><span>Selecciona un proyecto o crea el primero.</span></div></div>
            <span class="pm-chip">Base operacional</span>`;
          return;
        }
        const organization = project.organization || {};
        heading.innerHTML = `
          <div>
            <span class="pm-eyebrow">${escapeHTML(project.project_code)}</span>
            <h2>${escapeHTML(project.name)}</h2>
            <div class="pm-project-meta">
              <span>${escapeHTML(organization.display_name || organization.legal_name || 'Cliente')}</span>
              <span>${escapeHTML(formatDate(project.planned_start))} → ${escapeHTML(formatDate(project.committed_completion_date))}</span>
              <span>${escapeHTML(project.initial_estimated_working_days ?? '—')} días laborales base</span>
            </div>
          </div>
          <div class="pm-project-head-actions"><span class="pm-chip">${escapeHTML(statusLabel(project.status))}</span><button id="share-project-view" class="pm-button pm-button-quiet" type="button">↗ Compartir vista</button></div>`;
        document.getElementById('share-project-view').addEventListener('click', createProjectShareLink);
      }

      async function createProjectShareLink() {
        if (!state.selectedProjectId) return;
        const button = document.getElementById('share-project-view');
        button.disabled = true;
        button.textContent = 'Creando enlace…';
        try {
          const result = await projectRequest('', {
            method: 'POST',
            body: JSON.stringify({ action: 'create_share_link', project_id: state.selectedProjectId }),
          });
          const shareLink = result.share_link || {};
          if (!shareLink.id || !shareLink.token) throw new Error('No pudimos crear el enlace compartido.');
          const shareUrl = `${location.origin}/projects/share/?token=${encodeURIComponent(shareLink.token)}`;
          state.activeShareLinkId = shareLink.id;
          document.getElementById('project-share-url').value = shareUrl;
          document.getElementById('open-project-share').href = shareUrl;
          document.getElementById('project-share-expiry').textContent = shareLink.expires_at
            ? `Vigente hasta ${new Intl.DateTimeFormat('es-CL', { dateStyle: 'long', timeStyle: 'short' }).format(new Date(shareLink.expires_at))}.`
            : 'Sin vencimiento programado.';
          document.getElementById('project-share-message').textContent = '';
          document.getElementById('project-share-modal').classList.remove('pm-hidden');
        } catch (error) {
          setSyncStatus(error.message, false);
        } finally {
          button.disabled = false;
          button.textContent = '↗ Compartir vista';
        }
      }

      function closeProjectShareModal() {
        document.getElementById('project-share-modal').classList.add('pm-hidden');
        document.getElementById('project-share-message').textContent = '';
      }

      async function copyProjectShareLink() {
        const input = document.getElementById('project-share-url');
        try {
          await navigator.clipboard.writeText(input.value);
        } catch {
          input.select();
          document.execCommand('copy');
        }
        document.getElementById('project-share-message').textContent = 'Enlace copiado. Ya puedes enviarlo al cliente.';
      }

      async function revokeProjectShareLink() {
        if (!state.activeShareLinkId || !state.selectedProjectId) return;
        const button = document.getElementById('revoke-project-share');
        button.disabled = true;
        button.textContent = 'Revocando…';
        try {
          await projectRequest('', {
            method: 'POST',
            body: JSON.stringify({ action: 'revoke_share_link', project_id: state.selectedProjectId, share_link_id: state.activeShareLinkId }),
          });
          state.activeShareLinkId = null;
          document.getElementById('project-share-url').value = '';
          document.getElementById('open-project-share').removeAttribute('href');
          document.getElementById('project-share-message').textContent = 'El enlace fue revocado y ya no abre el cronograma.';
        } catch (error) {
          document.getElementById('project-share-message').textContent = error.message;
        } finally {
          button.disabled = false;
          button.textContent = 'Revocar enlace';
        }
      }

      function renderDepartmentManager() {
        const departments = state.bootstrap?.departments || [];
        const container = document.getElementById('department-management-list');
        container.innerHTML = departments.length ? departments.map((department) => {
          const taskCount = Number(department.task_count || 0);
          const blueprintCount = Number(department.blueprint_task_count || 0);
          const usageCount = taskCount + blueprintCount;
          const replacements = departments.filter((item) => item.id !== department.id);
          return `<div class="pm-department-manager-row" data-department-manager-id="${escapeHTML(department.id)}"><input class="pm-color-input" type="color" data-department-color value="${escapeHTML(safeDepartmentColor(department.color))}" aria-label="Color de ${escapeHTML(department.name)}"><input class="pm-input pm-input-compact" data-department-name value="${escapeHTML(department.name)}" maxlength="120" aria-label="Nombre del departamento"><div class="pm-department-usage"><strong>${taskCount} tareas · ${blueprintCount} plantillas</strong><span>${escapeHTML(department.code)}</span></div><button class="pm-button pm-button-quiet pm-input-compact" type="button" data-save-department>Guardar</button><button class="pm-button pm-button-quiet pm-button-danger pm-input-compact" type="button" data-delete-department>Eliminar</button>${usageCount ? `<div class="pm-department-replacement pm-field"><label>Antes de eliminar, mover tareas y plantillas a</label><select class="pm-input pm-input-compact" data-replacement-department>${replacements.map((item) => `<option value="${escapeHTML(item.id)}">${escapeHTML(item.name)}</option>`).join('')}</select></div>` : ''}</div>`;
        }).join('') : '<div class="pm-placeholder-note">No hay departamentos activos.</div>';
        container.querySelectorAll('select[data-replacement-department]').forEach(enhanceSelect);
        container.querySelectorAll('[data-save-department]').forEach((button) => button.addEventListener('click', () => updateDepartment(button.closest('[data-department-manager-id]'))));
        container.querySelectorAll('[data-delete-department]').forEach((button) => button.addEventListener('click', () => deleteDepartment(button)));
      }

      function openDepartmentsModal() {
        renderDepartmentManager();
        document.getElementById('department-management-message').textContent = '';
        document.getElementById('departments-modal').classList.remove('pm-hidden');
      }

      function closeDepartmentsModal() {
        closeCustomSelects();
        document.getElementById('departments-modal').classList.add('pm-hidden');
      }

      async function manageDepartment(department) {
        const result = await projectRequest('', { method:'POST', body:JSON.stringify({ action:'manage_department', department }) });
        await loadProjects(state.selectedProjectId);
        renderDepartmentManager();
        return result.department;
      }

      async function createDepartment(event) {
        event.preventDefault();
        const message = document.getElementById('department-management-message');
        const button = document.getElementById('create-department');
        button.disabled = true;
        button.textContent = 'Creando…';
        message.textContent = '';
        try {
          const department = await manageDepartment({
            action: 'create',
            name: document.getElementById('new-department-name').value,
            color: document.getElementById('new-department-color').value,
          });
          document.getElementById('create-department-form').reset();
          document.getElementById('new-department-color').value = '#72BEC7';
          message.textContent = `Departamento creado: ${department.name}.`;
        } catch (error) {
          message.textContent = error.message;
        } finally {
          button.disabled = false;
          button.textContent = 'Crear departamento';
        }
      }

      async function updateDepartment(row) {
        const message = document.getElementById('department-management-message');
        const button = row.querySelector('[data-save-department]');
        button.disabled = true;
        button.textContent = 'Guardando…';
        try {
          const department = await manageDepartment({ action:'update', department_id:row.dataset.departmentManagerId, name:row.querySelector('[data-department-name]').value, color:row.querySelector('[data-department-color]').value });
          message.textContent = `Departamento actualizado: ${department.name}.`;
        } catch (error) {
          message.textContent = error.message;
          button.disabled = false;
          button.textContent = 'Guardar';
        }
      }

      async function deleteDepartment(button) {
        const row = button.closest('[data-department-manager-id]');
        const message = document.getElementById('department-management-message');
        if (button.dataset.armed !== 'true') {
          button.dataset.armed = 'true';
          button.textContent = 'Confirmar';
          message.textContent = 'Confirma la eliminación. Las tareas y plantillas se moverán al departamento de reemplazo seleccionado.';
          return;
        }
        button.disabled = true;
        button.textContent = 'Eliminando…';
        try {
          const department = await manageDepartment({ action:'delete', department_id:row.dataset.departmentManagerId, replacement_department_id:row.querySelector('[data-replacement-department]')?.value || null });
          message.textContent = `${department.name} fue eliminado de los departamentos activos.`;
        } catch (error) {
          message.textContent = error.message;
          button.disabled = false;
          button.dataset.armed = 'false';
          button.textContent = 'Eliminar';
        }
      }

      function taskTimelineStart(task) {
        return task?.forecast_start || task?.planned_start || null;
      }

      function taskTimelineEnd(task) {
        return task?.forecast_end || task?.planned_end || taskTimelineStart(task);
      }

      function shiftDate(value, days) {
        if (!value || !days) return value || null;
        const date = new Date(`${value}T12:00:00`);
        const direction = days < 0 ? -1 : 1;
        let remaining = Math.abs(days);
        while (remaining) {
          date.setDate(date.getDate() + direction);
          if (date.getDay() !== 0 && date.getDay() !== 6) remaining -= 1;
        }
        return date.toISOString().slice(0, 10);
      }

      function timelineScheduleUpdate(task, days) {
        return {
          planned_start: shiftDate(task.planned_start, days),
          planned_end: shiftDate(task.planned_end, days),
          forecast_start: shiftDate(task.forecast_start, days),
          forecast_end: shiftDate(task.forecast_end, days),
        };
      }

      function setTimelineSelection(taskIds) {
        state.selectedTimelineTaskIds = new Set(taskIds);
        document.querySelectorAll('[data-draggable-task-id]').forEach((bar) => {
          bar.classList.toggle('is-selected', state.selectedTimelineTaskIds.has(bar.dataset.draggableTaskId));
        });
      }

      function updateTimelineDragOffset(offset) {
        const selected = state.timelineDrag?.taskIds || [];
        document.querySelectorAll('[data-draggable-task-id], [data-department-drag-id]').forEach((bar) => {
          const taskId = bar.dataset.draggableTaskId;
          const departmentId = bar.dataset.departmentDragId;
          if (taskId && !selected.includes(taskId)) return;
          if (departmentId && departmentId !== state.timelineDrag?.departmentId) return;
          bar.style.setProperty('--pm-drag-offset', `${offset}px`);
          bar.classList.add('is-dragging');
        });
      }

      function resetTimelineDragOffset() {
        document.querySelectorAll('[data-draggable-task-id], [data-department-drag-id]').forEach((bar) => {
          bar.style.removeProperty('--pm-drag-offset');
          bar.classList.remove('is-dragging');
        });
      }

      async function persistTimelineShift(taskIds, days) {
        const selectedTasks = (state.detail?.tasks || []).filter((task) => taskIds.includes(task.id) && !isMeetingTask(task));
        if (!selectedTasks.length || !days || !state.selectedProjectId) return;
        setSyncStatus(selectedTasks.length > 1 ? 'Moviendo actividades…' : 'Moviendo actividad…');
        // Commit the visual date change before the request completes. This keeps a successful drag in
        // its new slot instead of momentarily jumping back to the original schedule during the save.
        selectedTasks.forEach((task) => Object.assign(task, timelineScheduleUpdate(task, days)));
        renderWorkspace();
        const results = await Promise.allSettled(selectedTasks.map((task) => projectRequest('', {
            method: 'POST',
            body: JSON.stringify({
              action: 'update_task',
              project_id: state.selectedProjectId,
              task_id: task.id,
              version: task.version,
              task: timelineScheduleUpdate(task, days),
            }),
          })));
        const saved = results
          .filter((result) => result.status === 'fulfilled')
          .map((result) => result.value);
        const failed = results.filter((result) => result.status === 'rejected');
        if (saved.length) {
          saved.forEach((result) => replaceTaskState(result.task));
          renderWorkspace();
        }
        if (failed.length) {
          // Refresh after a partial write so the visual schedule can never fall back to stale client data.
          await selectProject(state.selectedProjectId);
          const reason = failed[0].reason instanceof Error ? failed[0].reason.message : 'No se pudo reprogramar';
          setSyncStatus(saved.length ? `${saved.length} actividades reprogramadas; revisa las restantes` : reason);
          return;
        }
        setSyncStatus(selectedTasks.length > 1 ? 'Actividades reprogramadas' : 'Actividad reprogramada', true);
      }

      function timelineDragState(bar, event, bounds, departmentId = null) {
        const axisRect = bar.closest('.pm-timeline-axis')?.getBoundingClientRect();
        if (!axisRect?.width) return null;
        const slotCount = bounds.workdays.length;
        const barRect = bar.getBoundingClientRect();
        const startSlot = Math.round((Number.parseFloat(bar.style.left || '0') / 100) * slotCount);
        return {
          departmentId,
          startX: event.clientX,
          axisWidth: axisRect.width,
          slotCount,
          startSlot,
          // Keep the point grabbed inside the bar fixed while calculating the destination slot.
          grabOffset: Math.max(0, Math.min(barRect.width, event.clientX - barRect.left)),
          moved: false,
        };
      }

      function timelineDropDays(bar, event, drag) {
        const axisRect = bar.closest('.pm-timeline-axis')?.getBoundingClientRect();
        if (!axisRect?.width || !drag.slotCount) return 0;
        const slotWidth = axisRect.width / drag.slotCount;
        const rawSlot = Math.round((event.clientX - axisRect.left - drag.grabOffset) / slotWidth);
        const targetSlot = Math.max(0, Math.min(drag.slotCount - 1, rawSlot));
        return targetSlot - drag.startSlot;
      }

      function timelinePreviewOffset(bar, event, drag) {
        const days = timelineDropDays(bar, event, drag);
        return days * (drag.axisWidth / drag.slotCount);
      }

      function bindTimelineDrag(bar, bounds) {
        bar.addEventListener('pointerdown', (event) => {
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return;
          const taskId = bar.dataset.draggableTaskId;
          if (!state.selectedTimelineTaskIds.has(taskId)) setTimelineSelection([taskId]);
          const drag = timelineDragState(bar, event, bounds);
          if (!drag) return;
          state.timelineDrag = { ...drag, taskIds: [...state.selectedTimelineTaskIds] };
          bar.setPointerCapture(event.pointerId);
          event.preventDefault();
        });
        bar.addEventListener('pointermove', (event) => {
          const drag = state.timelineDrag;
          if (!drag || !bar.hasPointerCapture(event.pointerId)) return;
          const offset = timelinePreviewOffset(bar, event, drag);
          if (offset) drag.moved = true;
          updateTimelineDragOffset(offset);
        });
        bar.addEventListener('pointerup', async (event) => {
          const drag = state.timelineDrag;
          if (!drag || !bar.hasPointerCapture(event.pointerId)) return;
          bar.releasePointerCapture(event.pointerId);
          state.timelineDrag = null;
          const days = timelineDropDays(bar, event, drag);
          resetTimelineDragOffset();
          if (drag.moved && days) {
            bar.dataset.dragged = 'true';
            await persistTimelineShift(drag.taskIds, days);
          }
        });
        bar.addEventListener('pointercancel', () => {
          state.timelineDrag = null;
          resetTimelineDragOffset();
        });
        bar.addEventListener('click', (event) => {
          if (bar.dataset.dragged === 'true') {
            delete bar.dataset.dragged;
            event.preventDefault();
            return;
          }
          const taskId = bar.dataset.draggableTaskId;
          if (event.metaKey || event.ctrlKey) {
            const selected = new Set(state.selectedTimelineTaskIds);
            if (selected.has(taskId)) selected.delete(taskId);
            else selected.add(taskId);
            setTimelineSelection(selected);
            renderTimeline();
            return;
          }
          openTaskModal(taskId);
        });
      }

      function bindDepartmentTimelineDrag(bar, departmentId, bounds) {
        bar.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          const taskIds = (state.detail?.tasks || []).filter((task) => task.department_id === departmentId && !isMeetingTask(task)).map((task) => task.id);
          if (!taskIds.length) return;
          const drag = timelineDragState(bar, event, bounds, departmentId);
          if (!drag) return;
          setTimelineSelection(taskIds);
          state.timelineDrag = { ...drag, taskIds };
          bar.setPointerCapture(event.pointerId);
          event.preventDefault();
        });
        bar.addEventListener('pointermove', (event) => {
          const drag = state.timelineDrag;
          if (!drag || !bar.hasPointerCapture(event.pointerId)) return;
          const offset = timelinePreviewOffset(bar, event, drag);
          if (offset) drag.moved = true;
          updateTimelineDragOffset(offset);
        });
        bar.addEventListener('pointerup', async (event) => {
          const drag = state.timelineDrag;
          if (!drag || !bar.hasPointerCapture(event.pointerId)) return;
          bar.releasePointerCapture(event.pointerId);
          state.timelineDrag = null;
          const days = timelineDropDays(bar, event, drag);
          resetTimelineDragOffset();
          if (drag.moved && days) await persistTimelineShift(drag.taskIds, days);
        });
        bar.addEventListener('pointercancel', () => {
          state.timelineDrag = null;
          resetTimelineDragOffset();
        });
      }

      function bindTimelineZoom(scroll) {
        scroll.addEventListener('wheel', (event) => {
          if (!event.altKey || !event.metaKey || !event.deltaY) return;
          event.preventDefault();
          const nextZoom = event.deltaY < 0 ? 2 : 1;
          if (nextZoom === state.timelineZoom) return;
          const pointerOffset = event.clientX - scroll.getBoundingClientRect().left;
          const focusRatio = (scroll.scrollLeft + pointerOffset) / Math.max(1, scroll.scrollWidth);
          state.timelineZoom = nextZoom;
          renderTimeline();
          const refreshedScroll = document.querySelector('#timeline-panel .pm-timeline-scroll');
          if (refreshedScroll) refreshedScroll.scrollLeft = Math.max(0, focusRatio * refreshedScroll.scrollWidth - pointerOffset);
        }, { passive: false });
      }

      function timelineBounds(tasks) {
        const values = tasks.flatMap((task) => [taskTimelineStart(task), taskTimelineEnd(task)]).filter(Boolean).map((value) => new Date(`${value}T12:00:00`).getTime());
        const today = new Date();
        today.setHours(12, 0, 0, 0);
        const minimum = values.length ? Math.min(...values) : today.getTime();
        const maximum = values.length ? Math.max(...values) : today.getTime() + 30 * 86400000;
        const start = new Date(minimum);
        start.setHours(12, 0, 0, 0);
        start.setDate(start.getDate() - ((start.getDay() + 6) % 7));
        const end = new Date(Math.max(maximum, start.getTime() + 14 * 86400000));
        end.setHours(12, 0, 0, 0);
        end.setDate(end.getDate() + ((5 - end.getDay() + 7) % 7));
        const workdays = [];
        const cursor = new Date(start);
        while (cursor <= end) {
          if (cursor.getDay() !== 0 && cursor.getDay() !== 6) workdays.push(cursor.toISOString().slice(0, 10));
          cursor.setDate(cursor.getDate() + 1);
        }
        return { start, end, workdays, dateIndex: new Map(workdays.map((value, index) => [value, index])) };
      }

      function renderTimeline() {
        const panel = document.getElementById('timeline-panel');
        const tasks = state.detail?.tasks || [];
        if (!state.detail) {
          panel.innerHTML = '<div class="pm-empty"><strong>El portafolio está listo para el primer proyecto</strong><p>La creación usa clientes reales del CRM y servicios canónicos. Cuando un servicio tenga una plantilla activa, sus tareas y dependencias se instanciarán automáticamente.</p></div>';
          return;
        }
        if (!tasks.length) {
          panel.innerHTML = '<div class="pm-empty"><strong>Este proyecto aún no tiene tareas</strong><p>Sus servicios quedaron vinculados y sus precios/plazos fueron capturados como línea base. El siguiente paso es calibrar y activar las plantillas de tareas de esos servicios.</p></div>';
          return;
        }
        const departments = state.bootstrap?.departments || [];
        const departmentMap = new Map(departments.map((department) => [department.id, department]));
        const departmentOrder = new Map(departments.map((department, index) => [department.id, Number(department.sort_order ?? index)]));
        const grouped = new Map();
        tasks.forEach((task) => {
          const key = task.department_id || 'unassigned';
          if (!grouped.has(key)) grouped.set(key, []);
          grouped.get(key).push(task);
        });
        const bounds = timelineBounds(tasks);
        const detailedTimeline = state.timelineZoom > 1;
        const axisLabels = bounds.workdays.map((value) => {
          const date = new Date(`${value}T12:00:00`);
          if (!detailedTimeline && date.getDay() !== 1) return '';
          return new Intl.DateTimeFormat('es-CL', detailedTimeline ? { weekday: 'short', day: '2-digit' } : { day: '2-digit', month: 'short' }).format(date);
        });
        const axisGrid = `<div class="pm-axis-grid" style="grid-template-columns:repeat(${bounds.workdays.length},minmax(0,1fr))">${bounds.workdays.map(() => '<span></span>').join('')}</div>`;
        const today = new Date();
        today.setHours(12, 0, 0, 0);
        const todayKey = today.toISOString().slice(0, 10);
        const todayIndex = bounds.dateIndex.get(todayKey);
        const todayPosition = todayIndex === undefined ? null : (todayIndex / bounds.workdays.length) * 100;
        const todayLabel = `Hoy · ${new Intl.DateTimeFormat('es-CL', { day: '2-digit', month: 'short' }).format(today)}`;
        const todayMarker = todayPosition !== null
          ? `<span class="pm-today-marker" style="left:${todayPosition}%" role="img" aria-label="Hoy"></span>`
          : '';
        const todayMarkerHeader = todayPosition !== null
          ? `<span class="pm-today-marker is-header" style="left:${todayPosition}%" data-today-label="${escapeHTML(todayLabel)}" role="img" aria-label="${escapeHTML(todayLabel)}"></span>`
          : '';
        const workdayIndex = (value, end = false) => {
          if (!value) return end ? bounds.workdays.length - 1 : 0;
          const date = new Date(`${value}T12:00:00`);
          while (date.getDay() === 0 || date.getDay() === 6) date.setDate(date.getDate() + (end ? -1 : 1));
          const index = bounds.dateIndex.get(date.toISOString().slice(0, 10));
          return Math.max(0, Math.min(bounds.workdays.length - 1, index ?? (end ? bounds.workdays.length - 1 : 0)));
        };
        const geometry = (startValue, endValue) => {
          const start = workdayIndex(startValue);
          const end = Math.max(start, workdayIndex(endValue || startValue, true));
          const left = (start / bounds.workdays.length) * 100;
          const width = Math.max(1.5, Math.min(100 - left, ((end - start + 1) / bounds.workdays.length) * 100));
          return { left, width };
        };
        const rows = [];
        const groups = [...grouped.entries()].sort(([departmentA], [departmentB]) => (
          (departmentOrder.get(departmentA) ?? 9999) - (departmentOrder.get(departmentB) ?? 9999)
        ));
        groups.forEach(([departmentId, departmentTasks]) => {
          const department = departmentMap.get(departmentId) || { name: 'Sin departamento', color: '#8f999f' };
          const color = safeDepartmentColor(department.color);
          const collapsed = state.collapsedDepartments.has(departmentId);
          // Calendar meetings retain their own schedule. The department bar is the movable work span,
          // so it must follow exactly the same records that a department drag can move.
          const movableDepartmentTasks = departmentTasks.filter((task) => !isMeetingTask(task));
          const datedTasks = movableDepartmentTasks.filter((task) => taskTimelineStart(task) || taskTimelineEnd(task));
          const groupStart = datedTasks.map((task) => taskTimelineStart(task) || taskTimelineEnd(task)).sort()[0];
          const groupEnd = datedTasks.map((task) => taskTimelineEnd(task) || taskTimelineStart(task)).sort().at(-1);
          const groupGeometry = geometry(groupStart, groupEnd);
          rows.push(`
            <div class="pm-timeline-row pm-department-row">
              <div class="pm-timeline-label">
                <button class="pm-department-toggle" type="button" data-department-toggle="${escapeHTML(departmentId)}" aria-expanded="${collapsed ? 'false' : 'true'}">
                  <span class="pm-department-toggle-icon">${collapsed ? '▶' : '▼'}</span>
                  <span class="pm-department-dot" style="background:${color}"></span>
                  <strong>${escapeHTML(department.name)}</strong>
                  <span class="pm-department-count">${departmentTasks.length}</span>
                </button>
              </div>
              <div class="pm-timeline-axis">${axisGrid}${todayMarker}<button class="pm-task-bar pm-department-summary ${movableDepartmentTasks.length ? 'is-draggable' : ''}" type="button" ${movableDepartmentTasks.length ? `data-department-drag-id="${escapeHTML(departmentId)}"` : 'disabled'} style="left:${groupGeometry.left}%;width:${groupGeometry.width}%;--department-color:${color}" aria-label="${movableDepartmentTasks.length ? 'Mover tareas de' : 'Sin tareas movibles en'} ${escapeHTML(department.name)}" title="${movableDepartmentTasks.length ? 'Arrastra para mover las tareas del departamento. Las reuniones de Calendar se mantienen en su fecha.' : 'Este departamento solo tiene reuniones de Calendar.'}">${escapeHTML(department.name)}</button></div>
            </div>`);
          if (collapsed) return;
          departmentTasks.forEach((task) => {
            const meeting = isMeetingTask(task);
            const taskGeometry = geometry(taskTimelineStart(task), taskTimelineEnd(task));
            const statusClass = task.status === 'completed' ? 'is-completed' : task.status === 'blocked' ? 'is-blocked' : '';
            const meetingClass = meeting ? 'is-meeting' : '';
            const timelineDetail = meeting
              ? `Reunión · ${meetingStatusLabel(task.status)} · ${Number(task.metadata?.calendar_event?.duration_minutes || task.planned_effort_minutes || 60)} min`
              : `${task.planned_effort_minutes ? `${Math.round(task.planned_effort_minutes / 60 * 10) / 10} h` : 'Sin horas'} · ${taskStatusLabel(task.status)}`;
            rows.push(`
              <div class="pm-timeline-row">
                <div class="pm-timeline-label">
                  <button class="pm-timeline-task-link" type="button" data-task-id="${escapeHTML(task.id)}">
                    <strong>${escapeHTML(task.title)}</strong>
                    <span>${escapeHTML(timelineDetail)}</span>
                  </button>
                </div>
                <div class="pm-timeline-axis">${axisGrid}${todayMarker}<button class="pm-task-bar ${statusClass} ${task.is_milestone ? 'is-milestone' : ''} ${meetingClass} ${meeting ? '' : 'is-draggable'} ${state.selectedTimelineTaskIds.has(task.id) ? 'is-selected' : ''}" type="button" data-task-id="${escapeHTML(task.id)}" ${meeting ? '' : `data-draggable-task-id="${escapeHTML(task.id)}"`} style="left:${taskGeometry.left}%;width:${taskGeometry.width}%;--department-color:${color}" aria-label="${meeting ? 'Abrir' : 'Arrastrar o abrir'} ${escapeHTML(task.title)}" title="${meeting ? task.title : `${task.title} · Arrastra para cambiar fechas · ⌘/Ctrl + clic para seleccionar`}">${task.is_milestone ? '' : meeting ? '◆' : escapeHTML(`${task.progress || 0}%`)}</button></div>
              </div>`);
          });
        });
        panel.innerHTML = `
          <div class="pm-timeline-toolbar"><strong>Plan por departamento</strong><span>${state.selectedTimelineTaskIds.size ? `${state.selectedTimelineTaskIds.size} seleccionada${state.selectedTimelineTaskIds.size === 1 ? '' : 's'} · ` : ''}${detailedTimeline ? 'Vista por día laboral' : 'Vista semanal'} · ⌥⌘ + scroll · Arrastra una actividad o barra de departamento</span></div>
          <div class="pm-timeline-scroll"><div class="pm-timeline" style="min-width:${Math.round((state.timelineBaseWidth || 820) * state.timelineZoom)}px">
            <div class="pm-timeline-row pm-timeline-header"><div class="pm-timeline-label">Actividad / dedicación</div><div class="pm-timeline-axis">${axisGrid}${todayMarkerHeader}<div class="pm-axis-labels" style="grid-template-columns:repeat(${bounds.workdays.length},minmax(0,1fr))">${axisLabels.map((label) => `<span>${escapeHTML(label)}</span>`).join('')}</div></div></div>
            ${rows.join('')}
          </div></div>`;
        const timelineScroll = panel.querySelector('.pm-timeline-scroll');
        if (!state.timelineBaseWidth && timelineScroll?.clientWidth) state.timelineBaseWidth = Math.max(820, timelineScroll.clientWidth);
        panel.querySelectorAll('[data-department-toggle]').forEach((button) => {
          button.addEventListener('click', () => {
            const departmentId = button.dataset.departmentToggle;
            if (state.collapsedDepartments.has(departmentId)) state.collapsedDepartments.delete(departmentId);
            else state.collapsedDepartments.add(departmentId);
            renderTimeline();
          });
        });
        panel.querySelectorAll('[data-department-drag-id]').forEach((button) => bindDepartmentTimelineDrag(button, button.dataset.departmentDragId, bounds));
        panel.querySelectorAll('[data-draggable-task-id]').forEach((button) => bindTimelineDrag(button, bounds));
        bindTimelineZoom(timelineScroll);
        panel.querySelectorAll('[data-task-id]:not([data-draggable-task-id])').forEach((button) => {
          button.addEventListener('click', () => openTaskModal(button.dataset.taskId));
        });
      }

      function renderTaskList() {
        const panel = document.getElementById('task-list-panel');
        const tasks = state.detail?.tasks || [];
        if (!state.detail) {
          panel.innerHTML = '<div class="pm-empty"><strong>Selecciona un proyecto</strong><p>La lista editable aparecerá agrupada por departamento.</p></div>';
          return;
        }
        if (!tasks.length) {
          panel.innerHTML = '<div class="pm-empty"><strong>Este proyecto aún no tiene tareas</strong><p>Cuando se instancie una plantilla, podrás editarlas desde aquí.</p></div>';
          return;
        }
        const departments = state.bootstrap?.departments || [];
        const departmentMap = new Map(departments.map((department) => [department.id, department]));
        const departmentOrder = new Map(departments.map((department, index) => [department.id, Number(department.sort_order ?? index)]));
        const direction = state.listDirection === 'desc' ? -1 : 1;
        const compareText = (left, right) => String(left || '').localeCompare(String(right || ''), 'es', { sensitivity: 'base' }) * direction;
        const compareTasks = (left, right) => {
          if (state.listSort === 'start') return compareText(taskTimelineStart(left), taskTimelineStart(right)) || compareText(left.title, right.title);
          if (state.listSort === 'end') return compareText(taskTimelineEnd(left), taskTimelineEnd(right)) || compareText(left.title, right.title);
          if (state.listSort === 'status') return compareText(taskStatusLabel(left.status), taskStatusLabel(right.status)) || compareText(left.title, right.title);
          if (state.listSort === 'title') return compareText(left.title, right.title);
          if (state.listSort === 'effort') return ((Number(left.planned_effort_minutes || 0) - Number(right.planned_effort_minutes || 0)) * direction) || compareText(left.title, right.title);
          return ((Number(left.sort_order || 0) - Number(right.sort_order || 0)) * direction) || compareText(left.title, right.title);
        };
        const grouped = new Map();
        tasks.forEach((task) => {
          const departmentId = task.department_id || 'unassigned';
          if (!grouped.has(departmentId)) grouped.set(departmentId, []);
          grouped.get(departmentId).push(task);
        });
        const groups = [...grouped.entries()].sort(([departmentA], [departmentB]) => (
          ((departmentOrder.get(departmentA) ?? 9999) - (departmentOrder.get(departmentB) ?? 9999)) * (state.listSort === 'department' ? direction : 1)
        ));
        const rows = groups.flatMap(([departmentId, departmentTasks]) => {
          const department = departmentMap.get(departmentId) || { name: 'Sin departamento', color: '#8f999f' };
          const color = safeDepartmentColor(department.color);
          const taskRows = [...departmentTasks].sort(compareTasks).map((task) => {
            const meeting = isMeetingTask(task);
            const progress = Math.max(0, Math.min(100, Number(task.progress || 0)));
            const linkedDocuments = Array.isArray(task.metadata?.linked_document_ids) ? task.metadata.linked_document_ids.length : 0;
            const minuteDocument = meeting ? (state.detail?.documents || []).find((document) => document.document_type === 'meeting_transcript' && String(document.metadata?.meeting_task_id || document.metadata?.task_id || '') === task.id) : null;
            const typeLabel = meeting ? 'Reunión' : task.is_milestone ? 'Hito' : 'Tarea';
            return `<tr>
              <td><button class="pm-task-open" type="button" data-task-id="${escapeHTML(task.id)}">${escapeHTML(task.title)}</button><span class="pm-task-subline">${escapeHTML(typeLabel)}${task.task_key ? ` · ${escapeHTML(task.task_key)}` : ''}</span></td>
              <td>${escapeHTML(formatDate(taskTimelineStart(task)))}</td>
              <td>${escapeHTML(formatDate(taskTimelineEnd(task)))}</td>
              <td><span class="pm-status-pill">${escapeHTML(meeting ? meetingStatusLabel(task.status) : taskStatusLabel(task.status))}</span></td>
              <td>${meeting ? '—' : `<div style="display:flex;align-items:center;gap:7px"><div class="pm-progress-track" style="--department-color:${color}"><span style="width:${progress}%"></span></div><span>${progress}%</span></div>`}</td>
              <td>${meeting ? `${Number(task.metadata?.calendar_event?.duration_minutes || task.planned_effort_minutes || 60)} min evento` : `${task.planned_effort_minutes ? `${Math.round(Number(task.planned_effort_minutes) / 6) / 10} h plan` : '—'}${task.actual_effort_minutes ? `<span class="pm-task-subline">${Math.round(Number(task.actual_effort_minutes) / 6) / 10} h real</span>` : ''}`}</td>
              <td>${meeting ? (minuteDocument ? 'Minuta vinculada' : 'Minuta pendiente') : (linkedDocuments ? `${linkedDocuments} vinculado${linkedDocuments === 1 ? '' : 's'}` : '—')}</td>
              <td><button class="pm-button pm-button-quiet pm-input-compact" type="button" data-task-id="${escapeHTML(task.id)}">Editar</button></td>
            </tr>`;
          });
          return [
            `<tr class="pm-task-group-row"><td colspan="8"><div class="pm-task-group-heading"><span class="pm-department-dot" style="background:${color}"></span><strong>${escapeHTML(department.name)}</strong><span>${departmentTasks.length} actividades</span></div></td></tr>`,
            ...taskRows,
          ];
        });
        panel.innerHTML = `
          <div class="pm-list-toolbar">
            <div class="pm-list-toolbar-copy"><strong>Lista editable por departamento</strong><span>Las tareas gestionan trabajo; las reuniones gestionan evento, personas, compromisos y minuta.</span></div>
            <div class="pm-list-controls">
              <div class="pm-list-control"><label for="task-list-sort">Ordenar por</label><select id="task-list-sort" class="pm-input pm-input-compact">
                <option value="department" ${state.listSort === 'department' ? 'selected' : ''}>Departamento</option>
                <option value="start" ${state.listSort === 'start' ? 'selected' : ''}>Fecha de inicio</option>
                <option value="end" ${state.listSort === 'end' ? 'selected' : ''}>Fecha de término</option>
                <option value="status" ${state.listSort === 'status' ? 'selected' : ''}>Estado</option>
                <option value="title" ${state.listSort === 'title' ? 'selected' : ''}>Nombre</option>
                <option value="effort" ${state.listSort === 'effort' ? 'selected' : ''}>Esfuerzo</option>
              </select></div>
              <button id="task-list-direction" class="pm-button pm-button-quiet pm-input-compact" type="button" aria-label="Cambiar dirección">${state.listDirection === 'asc' ? '↑ Asc.' : '↓ Desc.'}</button>
            </div>
          </div>
          <div class="pm-table-wrap"><table class="pm-table"><thead><tr><th>Actividad</th><th>Inicio previsto</th><th>Fin previsto</th><th>Estado</th><th>Avance</th><th>Dedicación</th><th>Documentos</th><th></th></tr></thead><tbody>${rows.join('')}</tbody></table></div>`;
        document.getElementById('task-list-sort').addEventListener('change', (event) => {
          state.listSort = event.target.value;
          renderTaskList();
        });
        enhanceSelect(document.getElementById('task-list-sort'));
        document.getElementById('task-list-direction').addEventListener('click', () => {
          state.listDirection = state.listDirection === 'asc' ? 'desc' : 'asc';
          renderTaskList();
        });
        panel.querySelectorAll('[data-task-id]').forEach((button) => {
          button.addEventListener('click', () => openTaskModal(button.dataset.taskId));
        });
      }

      function renderServices() {
        const panel = document.getElementById('services-panel');
        const services = state.detail?.services || [];
        if (!services.length) {
          panel.innerHTML = '<div class="pm-empty"><strong>Sin servicios vinculados</strong><p>Todo proyecto debe contener al menos un servicio canónico.</p></div>';
          return;
        }
        panel.innerHTML = `<div class="pm-table-wrap"><table class="pm-table"><thead><tr><th>Servicio</th><th>Plantilla</th><th>Estimación</th><th>Real</th><th>Eficiencia</th></tr></thead><tbody>${services.map((item) => {
          const service = item.service || {};
          const estimated = Number(item.estimated_effort_minutes || 0);
          const actual = Number(item.actual_effort_minutes || 0);
          const efficiency = estimated && actual ? `${Math.round(estimated / actual * 100)}%` : 'Pendiente';
          return `<tr><td><strong>${escapeHTML(service.service_name || item.service_snapshot?.service_name || 'Servicio')}</strong><br><span style="color:var(--pm-muted)">${escapeHTML(service.category || '')}</span></td><td>${item.baseline_blueprint_id ? 'Activa' : 'Por calibrar'}</td><td>${escapeHTML(item.estimated_working_days ?? '—')} días · ${estimated ? Math.round(estimated / 60 * 10) / 10 : '—'} h</td><td>${escapeHTML(item.actual_working_days ?? '—')} días · ${actual ? Math.round(actual / 60 * 10) / 10 : '—'} h</td><td>${escapeHTML(efficiency)}</td></tr>`;
        }).join('')}</tbody></table></div>`;
      }

      function isDriveFolder(item) {
        return item?.mime_type === 'application/vnd.google-apps.folder' || item?.metadata?.item_type === 'folder';
      }

      function driveItemFullPath(item) {
        const parentPath = String(item?.metadata?.folder_path || '').replace(/^\/+|\/+$/g, '');
        return [parentPath, String(item?.name || '')].filter(Boolean).join('/');
      }

      function driveItemTypeLabel(item) {
        if (isDriveFolder(item)) return 'Carpeta';
        const labels = { quote:'Cotización', contract:'Contrato', meeting_transcript:'Minuta', brief:'Brief', input:'Insumo', deliverable:'Entregable', supporting:'Soporte' };
        return labels[item?.document_type] || item?.document_type || 'Documento';
      }

      async function synchronizeDrive(button, messageId) {
        const message = document.getElementById(messageId);
        button.disabled = true;
        button.textContent = 'Sincronizando…';
        if (message) message.textContent = '';
        try {
          const result = await projectRequest('', {
            method: 'POST',
            body: JSON.stringify({ action:'sync_drive', project_id:state.selectedProjectId }),
          });
          await selectProject(state.selectedProjectId);
          setSyncStatus(`Drive: ${result.files} archivos · actualizado`, true);
          const refreshedMessage = document.getElementById(messageId);
          if (refreshedMessage) refreshedMessage.textContent = `${result.files} archivos visibles en ${result.folders} carpetas · ${result.missing || 0} referencias antiguas ocultadas · ${result.meeting_notes} minutas asociadas.`;
        } catch (error) {
          if (message) message.textContent = error.message;
          button.disabled = false;
          button.textContent = 'Sincronizar Drive';
        }
      }

      function bindDriveSyncButton(buttonId, messageId) {
        document.getElementById(buttonId)?.addEventListener('click', (event) => synchronizeDrive(event.currentTarget, messageId));
      }

      function renderDocuments() {
        const panel = document.getElementById('documents-panel');
        const items = state.detail?.documents || [];
        const project = state.detail?.project || {};
        if (!items.length) {
          const canSync = project.drive_root_id && !String(project.drive_root_id).startsWith('pending-drive:');
          panel.innerHTML = `<div class="pm-empty"><strong>${canSync ? 'La carpeta está conectada, pero aún no se ha inspeccionado' : 'Drive aún no está conectado'}</strong><p>La estructura distingue carpetas, cotizaciones, contratos, transcripciones, insumos y entregables. Las ediciones del agente se guardarán como propuestas; no existe ninguna acción de eliminación.</p>${canSync ? '<button id="sync-documents-drive" class="pm-button pm-button-primary" type="button">Sincronizar Drive</button><p id="documents-sync-message" class="pm-drive-sync-message"></p>' : ''}</div>`;
          if (canSync) bindDriveSyncButton('sync-documents-drive', 'documents-sync-message');
          return;
        }
        const rootId = String(project.drive_root_id || '');
        const rootUrl = rootId && !rootId.startsWith('pending-drive:') ? `https://drive.google.com/drive/folders/${encodeURIComponent(rootId)}` : '';
        const childrenByParent = new Map();
        items.forEach((item) => {
          const parentId = String(item.external_parent_id || rootId);
          if (!childrenByParent.has(parentId)) childrenByParent.set(parentId, []);
          childrenByParent.get(parentId).push(item);
        });
        const sortItems = (values = []) => [...values].sort((left, right) => {
          const folderDifference = Number(isDriveFolder(right)) - Number(isDriveFolder(left));
          return folderDifference || String(left.name || '').localeCompare(String(right.name || ''), 'es');
        });
        const rendered = new Set();
        const itemExternalIds = new Set(items.map((item) => String(item.external_file_id || item.id || '')).filter(Boolean));
        const renderNode = (item, depth, branch = new Set()) => {
          const externalId = String(item.external_file_id || item.id || '');
          if (!externalId || rendered.has(externalId) || branch.has(externalId)) return '';
          rendered.add(externalId);
          const folder = isDriveFolder(item);
          const collapsed = folder && state.collapsedDriveFolders.has(externalId);
          const url = driveDocumentUrl(item);
          const modified = item.metadata?.modified_time || item.updated_at;
          const nextBranch = new Set(branch);
          nextBranch.add(externalId);
          const children = folder && !collapsed
            ? sortItems(childrenByParent.get(externalId) || []).map((child) => renderNode(child, depth + 1, nextBranch)).join('')
            : '';
          return `<div class="pm-drive-tree-row ${folder ? 'is-folder' : ''}" style="--drive-depth:${Math.min(depth, 12)}"><div class="pm-drive-tree-name">${folder ? `<button class="pm-drive-tree-toggle" type="button" data-drive-folder-toggle="${escapeHTML(externalId)}" aria-expanded="${collapsed ? 'false' : 'true'}" aria-label="${collapsed ? 'Expandir' : 'Contraer'} ${escapeHTML(item.name)}">${collapsed ? '▶' : '▼'}</button>` : '<span class="pm-drive-tree-spacer"></span>'}<span class="pm-drive-tree-icon">${folder ? '◆' : '▤'}</span><div class="pm-drive-tree-copy">${url ? `<a href="${escapeHTML(url)}" target="_blank" rel="noopener"><strong>${escapeHTML(item.name)}</strong></a>` : `<strong>${escapeHTML(item.name)}</strong>`}<span>${escapeHTML(item.metadata?.folder_path || 'Raíz del proyecto')}</span></div></div><span class="pm-drive-tree-meta">${escapeHTML(driveItemTypeLabel(item))}</span><span class="pm-drive-tree-meta">${folder ? 'Navegable' : item.access_mode === 'suggest_only' ? 'Sugerencias + HIL' : 'Solo lectura'}${!folder && item.indexed_at ? ' · Indexado' : ''}</span>${url ? `<a class="pm-button pm-button-quiet pm-input-compact pm-link-button" href="${escapeHTML(url)}" target="_blank" rel="noopener">Abrir</a>` : `<span class="pm-drive-tree-meta">${escapeHTML(formatTimestamp(modified))}</span>`}</div>${children}`;
        };
        let treeMarkup = sortItems(childrenByParent.get(rootId) || []).map((item) => renderNode(item, 0)).join('');
        const orphans = sortItems(items.filter((item) => {
          const externalId = String(item.external_file_id || item.id || '');
          const parentId = String(item.external_parent_id || '');
          return !rendered.has(externalId) && parentId !== rootId && !itemExternalIds.has(parentId);
        }));
        if (orphans.length) treeMarkup += orphans.map((item) => renderNode(item, 0)).join('');
        const folderCount = items.filter(isDriveFolder).length + (rootId ? 1 : 0);
        const fileCount = items.length - items.filter(isDriveFolder).length;
        panel.innerHTML = `<div class="pm-drive-browser"><div class="pm-drive-browser-head"><div><strong>${escapeHTML(project.project_code || 'Proyecto')} · Archivos del proyecto</strong><span>${folderCount} carpetas · ${fileCount} archivos · Unidad compartida de Rasika</span></div><div class="pm-drive-browser-actions"><button id="sync-documents-drive" class="pm-button pm-button-primary" type="button">Sincronizar Drive</button>${rootUrl ? `<a class="pm-button pm-button-quiet pm-link-button" href="${escapeHTML(rootUrl)}" target="_blank" rel="noopener">Abrir raíz</a>` : ''}</div></div>${treeMarkup || '<div class="pm-placeholder-note">La carpeta del proyecto está vacía.</div>'}</div><p id="documents-sync-message" class="pm-drive-sync-message"></p>`;
        panel.querySelectorAll('[data-drive-folder-toggle]').forEach((button) => button.addEventListener('click', () => {
          const folderId = button.dataset.driveFolderToggle;
          if (state.collapsedDriveFolders.has(folderId)) state.collapsedDriveFolders.delete(folderId);
          else state.collapsedDriveFolders.add(folderId);
          renderDocuments();
        }));
        bindDriveSyncButton('sync-documents-drive', 'documents-sync-message');
      }

      function renderMinutes() {
        const panel = document.getElementById('minutes-panel');
        if (!state.detail) {
          panel.innerHTML = '<div class="pm-empty"><strong>Selecciona un proyecto</strong><p>Las minutas se organizan dentro de cada proyecto.</p></div>';
          return;
        }
        const project = state.detail.project || {};
        const tasks = state.detail.tasks || [];
        const documents = state.detail.documents || [];
        const departments = state.bootstrap?.departments || [];
        const departmentMap = new Map(departments.map((department) => [department.id, department]));
        const meetingTasks = tasks.filter(isMeetingTask).sort((left, right) => String(left.planned_start || '').localeCompare(String(right.planned_start || '')));
        const minuteDocuments = documents.filter((document) => document.document_type === 'meeting_transcript');
        const notesByTask = new Map();
        minuteDocuments.forEach((document) => {
          const meetingTaskId = document.metadata?.meeting_task_id || document.metadata?.task_id;
          if (meetingTaskId) notesByTask.set(String(meetingTaskId), document);
        });
        const matchedDocumentIds = new Set([...notesByTask.values()].map((document) => document.id));
        const unassignedMinutes = minuteDocuments.filter((document) => !matchedDocumentIds.has(document.id));
        const indexedCount = minuteDocuments.filter((document) => document.indexed_at).length;
        const folderId = String(project.drive_root_id || '');
        const folderUrl = folderId && !folderId.startsWith('pending-drive:') ? `https://drive.google.com/drive/folders/${encodeURIComponent(folderId)}` : '';
        const dateTile = (value) => {
          if (!value) return '<div class="pm-minute-date"><strong>—</strong><span>Sin fecha</span></div>';
          const date = new Date(`${value}T12:00:00`);
          return `<div class="pm-minute-date"><strong>${escapeHTML(new Intl.DateTimeFormat('es-CL', { day: '2-digit', month: 'short' }).format(date))}</strong><span>${escapeHTML(new Intl.DateTimeFormat('es-CL', { weekday: 'short' }).format(date))}</span></div>`;
        };
        const renderMeeting = (task) => {
          const note = notesByTask.get(task.id);
          const meetingDetails = task.metadata?.meeting_details || {};
          const attendeeCount = Array.isArray(meetingDetails.attendees) ? meetingDetails.attendees.length : 0;
          const responsibleCount = Array.isArray(meetingDetails.responsible_people) ? meetingDetails.responsible_people.length : 0;
          const pendingCommitments = Array.isArray(meetingDetails.commitments) ? meetingDetails.commitments.filter((item) => item.status !== 'completed').length : 0;
          const department = departmentMap.get(task.department_id) || { name: 'Sin departamento', color: '#8f999f' };
          const color = safeDepartmentColor(department.color);
          const noteUrl = note ? driveDocumentUrl(note) : '';
          const agentReady = Boolean(note?.indexed_at);
          return `<article class="pm-minute-card">
            ${dateTile(task.planned_start)}
            <div class="pm-minute-copy">
              <h4><span class="pm-department-dot" style="background:${color}"></span>${escapeHTML(task.title)}</h4>
              <p>${note ? escapeHTML(note.name) : 'Notes by Gemini se asociará automáticamente desde el evento y la carpeta Minutas.'}</p>
              <div class="pm-minute-meta"><span>${escapeHTML(department.name)}</span><span>${attendeeCount} asistentes</span><span>${responsibleCount} responsables</span><span>${pendingCommitments} compromisos pendientes</span><span>${note ? escapeHTML(formatTimestamp(note.metadata?.modified_time || note.updated_at)) : 'Minuta pendiente'}</span><span>${note ? 'Fuente en modo solo lectura' : 'Visible solo internamente'}</span></div>
            </div>
            <div class="pm-minute-card-actions">
              <span class="pm-status-pill ${agentReady ? 'pm-agent-ready' : 'pm-agent-pending'}">${agentReady ? 'Disponible al agente' : note ? 'Pendiente de indexar' : 'Pendiente'}</span>
              ${noteUrl ? `<a class="pm-button pm-button-quiet pm-input-compact pm-link-button" href="${escapeHTML(noteUrl)}" target="_blank" rel="noopener">Abrir minuta</a>` : ''}
            </div>
          </article>`;
        };
        const renderUnassignedMinute = (note) => {
          const date = note.metadata?.meeting_date || '';
          const noteUrl = driveDocumentUrl(note);
          return `<article class="pm-minute-card">
            ${dateTile(date)}
            <div class="pm-minute-copy"><h4><span class="pm-department-dot" style="background:var(--pm-accent)"></span>${escapeHTML(note.name)}</h4><p>Minuta importada; falta asociarla a una reunión del cronograma.</p><div class="pm-minute-meta"><span>${escapeHTML(formatTimestamp(note.metadata?.modified_time || note.updated_at))}</span><span>Solo lectura</span></div></div>
            <div class="pm-minute-card-actions"><span class="pm-status-pill ${note.indexed_at ? 'pm-agent-ready' : 'pm-agent-pending'}">${note.indexed_at ? 'Disponible al agente' : 'Pendiente de indexar'}</span>${noteUrl ? `<a class="pm-button pm-button-quiet pm-input-compact pm-link-button" href="${escapeHTML(noteUrl)}" target="_blank" rel="noopener">Abrir minuta</a>` : ''}</div>
          </article>`;
        };
        panel.innerHTML = `<div class="pm-minutes">
          <section class="pm-minutes-hero">
            <div><span class="pm-eyebrow">Memoria del proyecto</span><h3>Minutas y Notes by Gemini</h3><p>Las notas de cada reunión se conservarán como documentos de solo lectura. Después de indexarlas, el agente podrá consultar acuerdos, responsables, fechas, bloqueos y prioridades para responder preguntas o proponer cambios en el plan.</p></div>
            <div class="pm-minutes-actions"><button id="sync-minutes-drive" class="pm-button pm-button-primary" type="button">Sincronizar Drive</button>${folderUrl ? `<a class="pm-button pm-button-quiet pm-link-button" href="${escapeHTML(folderUrl)}" target="_blank" rel="noopener">Abrir carpeta</a>` : '<span class="pm-status-pill pm-agent-pending">Drive pendiente</span>'}</div>
          </section>
          <div class="pm-minutes-stats"><article class="pm-minute-stat"><span>Reuniones del plan</span><strong>${meetingTasks.length}</strong></article><article class="pm-minute-stat"><span>Minutas disponibles</span><strong>${minuteDocuments.length}</strong></article><article class="pm-minute-stat"><span>Listas para el agente</span><strong>${indexedCount}</strong></article></div>
          <section class="pm-minute-knowledge"><span class="pm-minute-knowledge-icon">✦</span><div><strong>Contexto autorizado para el futuro agente</strong><p>El agente podrá leer la versión indexada y citar su minuta de origen. Reprogramar tareas, cambiar responsables o priorizar eventos seguirá requiriendo una propuesta explícita y aprobación humana antes de ejecutarse.</p></div></section>
          <p id="minutes-sync-message" class="pm-minutes-message"></p>
          <div class="pm-minute-list">${meetingTasks.map(renderMeeting).join('')}${unassignedMinutes.map(renderUnassignedMinute).join('') || (!meetingTasks.length ? '<div class="pm-empty"><strong>No hay reuniones planificadas</strong><p>Las reuniones del cronograma aparecerán aquí para recibir su minuta.</p></div>' : '')}</div>
        </div>`;
        bindDriveSyncButton('sync-minutes-drive', 'minutes-sync-message');
      }

      function renderActivity() {
        const activity = state.detail?.activity || [];
        document.getElementById('activity-panel').innerHTML = activity.length
          ? `<div class="pm-table-wrap"><table class="pm-table"><thead><tr><th>Fecha</th><th>Actor</th><th>Evento</th><th>Detalle</th></tr></thead><tbody>${activity.map((item) => `<tr><td>${escapeHTML(new Date(item.occurred_at).toLocaleString('es-CL'))}</td><td>${escapeHTML(item.actor_type)}</td><td>${escapeHTML(item.event_type)}</td><td>${escapeHTML(item.summary)}</td></tr>`).join('')}</tbody></table></div>`
          : '<div class="pm-empty"><strong>Sin actividad registrada</strong><p>Las acciones humanas, del agente y de integraciones aparecerán en este registro inmutable.</p></div>';
      }

      function safeExternalUrl(value) {
        try {
          const url = new URL(String(value || ''));
          return url.protocol === 'https:' ? url.toString() : '';
        } catch {
          return '';
        }
      }

      function driveDocumentUrl(document) {
        const metadataUrl = safeExternalUrl(document?.metadata?.web_view_link || document?.metadata?.webViewLink || document?.metadata?.url);
        if (metadataUrl) return metadataUrl;
        const fileId = String(document?.external_file_id || '');
        if (!fileId || fileId.startsWith('pending-drive:')) return '';
        if (isDriveFolder(document)) return `https://drive.google.com/drive/folders/${encodeURIComponent(fileId)}`;
        return `https://drive.google.com/open?id=${encodeURIComponent(fileId)}`;
      }

      function normalizeDriveLabel(value) {
        return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
      }

      function renderRequiredInputs(items = []) {
        const container = document.getElementById('task-required-inputs');
        const normalized = items.map((item) => {
          if (typeof item === 'string') return { id: crypto.randomUUID(), label: item, completed: false };
          return { id: item?.id || crypto.randomUUID(), label: item?.label || item?.name || item?.type || '', completed: item?.completed === true };
        }).filter((item) => item.label);
        container.innerHTML = normalized.length ? normalized.map((item) => `
          <div class="pm-check-row ${item.completed ? 'is-complete' : ''}" data-required-input-id="${escapeHTML(item.id)}">
            <input type="checkbox" data-required-input-check ${item.completed ? 'checked' : ''} aria-label="Completar insumo" />
            <input type="text" data-required-input-label value="${escapeHTML(item.label)}" maxlength="300" aria-label="Insumo requerido" />
            <button class="pm-icon-button" type="button" data-remove-required-input aria-label="Eliminar insumo">×</button>
          </div>`).join('') : '<div class="pm-placeholder-note">No hay insumos registrados. Agrégalos como ítems verificables.</div>';
        container.querySelectorAll('[data-required-input-check]').forEach((checkbox) => {
          checkbox.addEventListener('change', () => checkbox.closest('.pm-check-row').classList.toggle('is-complete', checkbox.checked));
        });
        container.querySelectorAll('[data-remove-required-input]').forEach((button) => {
          button.addEventListener('click', () => {
            button.closest('.pm-check-row').remove();
            if (!container.querySelector('.pm-check-row')) container.innerHTML = '<div class="pm-placeholder-note">No hay insumos registrados. Agrégalos como ítems verificables.</div>';
          });
        });
      }

      function addRequiredInput() {
        const existing = [...document.querySelectorAll('#task-required-inputs [data-required-input-id]')].map((row) => ({
          id: row.dataset.requiredInputId,
          label: row.querySelector('[data-required-input-label]').value,
          completed: row.querySelector('[data-required-input-check]').checked,
        }));
        existing.push({ id: crypto.randomUUID(), label: 'Nuevo insumo', completed: false });
        renderRequiredInputs(existing);
        document.querySelector('#task-required-inputs [data-required-input-id]:last-child [data-required-input-label]')?.select();
      }

      function renderRequiredTasks(task) {
        const dependencies = (state.detail?.dependencies || []).filter((item) => item.successor_task_id === task.id);
        const tasksById = new Map((state.detail?.tasks || []).map((item) => [item.id, item]));
        const required = dependencies.map((item) => tasksById.get(item.predecessor_task_id)).filter(Boolean);
        const container = document.getElementById('task-required-tasks');
        container.innerHTML = required.length ? required.map((item) => {
          const complete = item.status === 'completed' || Number(item.progress || 0) >= 100;
          return `<div class="pm-check-row ${complete ? 'is-complete' : ''}"><input type="checkbox" ${complete ? 'checked' : ''} disabled aria-label="${complete ? 'Completada' : 'Pendiente'}" /><button class="pm-task-open pm-check-label" type="button" data-required-task-id="${escapeHTML(item.id)}">${escapeHTML(item.title)}</button><span class="pm-status-pill">${escapeHTML(taskStatusLabel(item.status))}</span></div>`;
        }).join('') : '<div class="pm-placeholder-note">Esta tarea no depende de otras tareas.</div>';
        container.querySelectorAll('[data-required-task-id]').forEach((button) => button.addEventListener('click', () => openTaskModal(button.dataset.requiredTaskId)));
      }

      function renderTaskDrive(task) {
        const project = state.detail?.project || {};
        const allItems = state.detail?.documents || [];
        const folders = allItems.filter(isDriveFolder);
        const files = allItems.filter((item) => !isDriveFolder(item));
        const department = (state.bootstrap?.departments || []).find((item) => item.id === task.department_id);
        const explicitFolderId = String(task.metadata?.drive_folder_id || '');
        const departmentLabel = normalizeDriveLabel(department?.name);
        const matchedFolder = folders.find((item) => String(item.external_file_id) === explicitFolderId)
          || folders.find((item) => departmentLabel && normalizeDriveLabel(item.name).includes(departmentLabel));
        const folderId = String(matchedFolder?.external_file_id || explicitFolderId || project.drive_root_id || '');
        const pendingFolder = !folderId || folderId.startsWith('pending-drive:');
        const folderUrl = driveDocumentUrl(matchedFolder) || safeExternalUrl(task.metadata?.drive_folder_url) || (folderId && !folderId.startsWith('pending-drive:') ? `https://drive.google.com/drive/folders/${encodeURIComponent(folderId)}` : '');
        const linkedIds = new Set(Array.isArray(task.metadata?.linked_document_ids) ? task.metadata.linked_document_ids : []);
        const linkedDocuments = files.filter((document) => linkedIds.has(document.id));
        const folderPath = matchedFolder ? driveItemFullPath(matchedFolder) : '';
        const scopedFiles = folderPath ? files.filter((item) => {
          const itemPath = String(item.metadata?.folder_path || '');
          return itemPath === folderPath || itemPath.startsWith(`${folderPath}/`);
        }) : files;
        const recentCandidates = [...scopedFiles];
        linkedDocuments.forEach((document) => {
          if (!recentCandidates.some((candidate) => candidate.id === document.id)) recentCandidates.push(document);
        });
        const documents = recentCandidates
          .sort((left, right) => String(right.metadata?.modified_time || right.updated_at || '').localeCompare(String(left.metadata?.modified_time || left.updated_at || '')))
          .slice(0, 3);
        const childFolders = folderId ? folders.filter((item) => String(item.external_parent_id || '') === folderId).slice(0, 5) : [];
        const foldersMarkup = childFolders.map((folder) => {
          const url = driveDocumentUrl(folder);
          return `<div class="pm-file-row"><span class="pm-file-icon">◆</span><span class="pm-file-copy"><strong>${escapeHTML(folder.name)}</strong><span>Subcarpeta de Drive</span></span>${url ? `<a class="pm-button pm-button-quiet pm-input-compact pm-link-button" href="${escapeHTML(url)}" target="_blank" rel="noopener">Abrir</a>` : ''}</div>`;
        }).join('');
        const filesMarkup = documents.length ? documents.map((document) => {
          const url = driveDocumentUrl(document);
          const modified = document.metadata?.modified_time || document.updated_at;
          return `<div class="pm-file-row"><span class="pm-file-icon">▤</span><span class="pm-file-copy"><strong>${escapeHTML(document.name)}</strong><span>${escapeHTML(formatTimestamp(modified))}</span></span>${url ? `<a class="pm-button pm-button-quiet pm-input-compact pm-link-button" href="${escapeHTML(url)}" target="_blank" rel="noopener">Abrir</a>` : '<span class="pm-status-pill">Pendiente</span>'}</div>`;
        }).join('') : '<div class="pm-placeholder-note">No hay archivos sincronizados dentro de esta carpeta todavía.</div>';
        const folderName = matchedFolder?.name || (pendingFolder ? 'Carpeta pendiente de conexión' : 'Carpeta raíz del proyecto');
        document.getElementById('task-drive-card').innerHTML = `<div class="pm-integration-head"><div><strong>${escapeHTML(folderName)}</strong><span>${pendingFolder ? 'Usará la conexión de servicio al Shared Drive de Rasika' : department ? `Drive · ${escapeHTML(department.name)} · subcarpetas y archivos recientes` : 'Drive · carpeta y subcarpetas'}</span></div>${folderUrl ? `<a class="pm-button pm-button-quiet pm-input-compact pm-link-button" href="${escapeHTML(folderUrl)}" target="_blank" rel="noopener">Abrir carpeta</a>` : '<button class="pm-button pm-button-quiet pm-input-compact" type="button" data-provision-project-drive>Crear prueba en Drive</button>'}</div>${foldersMarkup}${filesMarkup}`;
        document.querySelector('[data-provision-project-drive]')?.addEventListener('click', async (event) => {
          const button = event.currentTarget;
          const message = document.getElementById('task-form-message');
          button.disabled = true;
          button.textContent = 'Creando…';
          message.textContent = '';
          try {
            const result = await projectRequest('', {
              method: 'POST',
              body: JSON.stringify({ action: 'provision_drive_test', project_id: state.selectedProjectId }),
            });
            await selectProject(state.selectedProjectId);
            const refreshedTask = (state.detail?.tasks || []).find((item) => item.id === state.editingTaskId) || task;
            renderTaskDrive(refreshedTask);
            message.textContent = `${result.test_folder?.name || 'Carpeta de prueba'} y ${result.test_file?.name || 'archivo de prueba'} disponibles en Drive.`;
            setSyncStatus('Drive conectado', true);
          } catch (error) {
            message.textContent = error.message;
            button.disabled = false;
            button.textContent = 'Crear prueba en Drive';
          }
        });
      }

      function closeCalendarPicker() {
        state.calendarLinkContext = null;
        document.getElementById('calendar-existing-picker').classList.add('pm-hidden');
        document.getElementById('calendar-event-results').innerHTML = '<div class="pm-placeholder-note">Busca eventos de los calendarios autorizados para vincularlos sin duplicarlos.</div>';
      }

      function renderCalendarEventResults(events = []) {
        const container = document.getElementById('calendar-event-results');
        container.innerHTML = events.length ? events.map((event) => `
          <div class="pm-calendar-event-option" data-existing-calendar-event>
            <div><strong>${escapeHTML(event.summary || 'Evento sin título')}</strong><span>${escapeHTML(formatCalendarDateTime(event.startsAt))} · ${escapeHTML(event.calendarLabel || 'Google Calendar')}${event.location ? ` · ${escapeHTML(event.location)}` : ''}</span></div>
            <button class="pm-button pm-button-quiet pm-input-compact" type="button" data-link-existing-calendar-event data-calendar-id="${escapeHTML(event.calendarId)}" data-event-id="${escapeHTML(event.id)}">Vincular</button>
          </div>`).join('') : '<div class="pm-placeholder-note">No se encontraron eventos en el período autorizado.</div>';
        container.querySelectorAll('[data-link-existing-calendar-event]').forEach((button) => button.addEventListener('click', async () => {
          const context = state.calendarLinkContext;
          const message = document.getElementById('task-form-message');
          if (!context?.taskId) return;
          button.disabled = true;
          button.textContent = 'Vinculando…';
          message.textContent = '';
          try {
            const result = await projectRequest('', {
              method: 'POST',
              body: JSON.stringify({
                action: 'link_calendar_event',
                project_id: state.selectedProjectId,
                task_id: context.taskId,
                block_id: context.blockId || null,
                calendar_id: button.dataset.calendarId,
                event_id: button.dataset.eventId,
                ...(context.meeting ? { meeting_details: {
                  attendees: collectMeetingPeople('meeting-attendees'),
                  responsible_people: collectMeetingPeople('meeting-responsibles'),
                  commitments: collectMeetingCommitments(),
                } } : {}),
              }),
            });
            replaceTaskState(result.task);
            if (context.meeting) {
              renderMeetingEditor(result.task);
            } else {
              state.editingCalendarBlocks = (result.task.metadata?.calendar_blocks || []).map((block) => ({ ...block }));
              renderCalendarBlocks();
            }
            closeCalendarPicker();
            message.textContent = 'Evento existente vinculado sin crear un duplicado.';
            setSyncStatus('Calendar conectado', true);
          } catch (error) {
            message.textContent = error.message;
            button.disabled = false;
            button.textContent = 'Vincular';
          }
        }));
      }

      async function loadExistingCalendarEvents() {
        const button = document.getElementById('search-calendar-events');
        const container = document.getElementById('calendar-event-results');
        button.disabled = true;
        button.textContent = 'Buscando…';
        container.innerHTML = '<div class="pm-placeholder-note">Consultando Google Calendar…</div>';
        try {
          const result = await projectRequest('', {
            method: 'POST',
            body: JSON.stringify({ action: 'list_calendar_events', project_id: state.selectedProjectId, query: document.getElementById('calendar-event-query').value.trim() }),
          });
          renderCalendarEventResults(result.events || []);
          setSyncStatus('Calendar conectado', true);
        } catch (error) {
          container.innerHTML = `<div class="pm-placeholder-note" style="color:var(--pm-danger)">${escapeHTML(error.message)}</div>`;
        } finally {
          button.disabled = false;
          button.textContent = 'Buscar';
        }
      }

      function openCalendarPicker({ taskId, blockId = null, meeting = false }) {
        state.calendarLinkContext = { taskId, blockId, meeting };
        const picker = document.getElementById('calendar-existing-picker');
        const anchor = meeting
          ? document.getElementById('meeting-calendar-event').closest('[data-meeting-only]')
          : document.getElementById('task-calendar-blocks').closest('[data-task-only]');
        anchor?.insertAdjacentElement('afterend', picker);
        picker.classList.remove('pm-hidden');
        const query = document.getElementById('calendar-event-query');
        query.value = '';
        loadExistingCalendarEvents();
        requestAnimationFrame(() => {
          picker.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          query.focus({ preventScroll: true });
        });
      }

      function renderCalendarBlocks() {
        const container = document.getElementById('task-calendar-blocks');
        container.innerHTML = state.editingCalendarBlocks.length ? state.editingCalendarBlocks.map((block) => {
          const eventUrl = safeExternalUrl(block.event_url);
          return `<div class="pm-calendar-row" data-calendar-block-id="${escapeHTML(block.id)}"><span class="pm-hours-badge">${escapeHTML(block.duration_hours)} h</span><span class="pm-calendar-copy"><strong>${escapeHTML(block.title || `Bloque de trabajo · ${block.duration_hours} h`)}</strong><span>${block.event_id ? 'Evento vinculado · un bloque, un evento' : 'Elige fecha y hora antes de crear o vincula uno existente'}</span></span><span class="pm-calendar-schedule"><input class="pm-input pm-input-compact" type="datetime-local" data-calendar-start value="${escapeHTML(block.starts_at || '')}" ${block.event_id ? 'disabled' : ''} aria-label="Inicio del bloque"><select class="pm-input pm-input-compact" data-calendar-status><option value="not_started" ${block.status === 'not_started' ? 'selected' : ''}>No iniciado</option><option value="in_progress" ${block.status === 'in_progress' ? 'selected' : ''}>En curso</option><option value="completed" ${block.status === 'completed' ? 'selected' : ''}>Completo</option></select></span><span class="pm-calendar-actions"><span class="pm-calendar-actions-stack">${eventUrl ? `<a class="pm-button pm-button-quiet pm-input-compact pm-link-button" href="${escapeHTML(eventUrl)}" target="_blank" rel="noopener">Abrir evento</a>` : '<button class="pm-button pm-button-quiet pm-input-compact" type="button" data-create-calendar-event>Crear en Calendar</button><button class="pm-button pm-button-quiet pm-input-compact" type="button" data-link-calendar-block-event>Vincular existente</button>'}</span><button class="pm-icon-button" type="button" data-remove-calendar-block aria-label="Eliminar bloque">×</button></span></div>`;
        }).join('') : '<div class="pm-placeholder-note">Agrega bloques de 2 o 4 horas. La creación en Google Calendar se activará al conectar OAuth.</div>';
        container.querySelectorAll('select[data-calendar-status]').forEach(enhanceSelect);
        container.querySelectorAll('[data-calendar-status]').forEach((select) => select.addEventListener('change', () => {
          const block = state.editingCalendarBlocks.find((item) => item.id === select.closest('[data-calendar-block-id]').dataset.calendarBlockId);
          if (block) block.status = select.value;
        }));
        container.querySelectorAll('[data-calendar-start]').forEach((input) => input.addEventListener('change', () => {
          const block = state.editingCalendarBlocks.find((item) => item.id === input.closest('[data-calendar-block-id]').dataset.calendarBlockId);
          if (block) block.starts_at = input.value;
        }));
        container.querySelectorAll('[data-remove-calendar-block]').forEach((button) => button.addEventListener('click', () => {
          const id = button.closest('[data-calendar-block-id]').dataset.calendarBlockId;
          state.editingCalendarBlocks = state.editingCalendarBlocks.filter((item) => item.id !== id);
          renderCalendarBlocks();
        }));
        container.querySelectorAll('[data-link-calendar-block-event]').forEach((button) => button.addEventListener('click', () => {
          openCalendarPicker({ taskId: state.editingTaskId, blockId: button.closest('[data-calendar-block-id]').dataset.calendarBlockId, meeting: false });
        }));
        container.querySelectorAll('[data-create-calendar-event]').forEach((button) => button.addEventListener('click', async () => {
          const row = button.closest('[data-calendar-block-id]');
          const blockId = row.dataset.calendarBlockId;
          const localStart = row.querySelector('[data-calendar-start]').value;
          const message = document.getElementById('task-form-message');
          if (!localStart) { message.textContent = 'Selecciona la fecha y hora del bloque.'; return; }
          button.disabled = true;
          button.textContent = 'Creando…';
          message.textContent = '';
          try {
            const currentTask = (state.detail?.tasks || []).find((item) => item.id === state.editingTaskId);
            const localBlock = state.editingCalendarBlocks.find((item) => item.id === blockId);
            if (!currentTask || !localBlock) throw new Error('No se encontró el bloque en edición.');
            localBlock.starts_at = localStart;
            const saved = await projectRequest('', {
              method: 'POST',
              body: JSON.stringify({ action: 'update_task', project_id: state.selectedProjectId, task_id: currentTask.id, version: currentTask.version, task: { calendar_blocks: state.editingCalendarBlocks } }),
            });
            replaceTaskState(saved.task);
            state.editingCalendarBlocks = (saved.task.metadata?.calendar_blocks || []).map((block) => ({ ...block }));
            const result = await projectRequest('', {
              method:'POST',
              body:JSON.stringify({ action:'create_calendar_event', project_id:state.selectedProjectId, task_id:state.editingTaskId, block_id:blockId, local_start:localStart }),
            });
            replaceTaskState(result.task);
            state.editingCalendarBlocks = (result.task.metadata?.calendar_blocks || []).map((block) => ({ ...block }));
            renderCalendarBlocks();
            message.textContent = 'Bloque creado y vinculado a Google Calendar.';
            setSyncStatus('Calendar actualizado', true);
          } catch (error) {
            message.textContent = error.message;
            button.disabled = false;
            button.textContent = 'Crear en Calendar';
          }
        }));
      }

      function addCalendarBlock(durationHours) {
        const task = (state.detail?.tasks || []).find((item) => item.id === state.editingTaskId);
        state.editingCalendarBlocks.push({ id: crypto.randomUUID(), duration_hours: durationHours, status: 'not_started', title: `Bloque de trabajo · ${durationHours} h`, event_id: null, event_url: null, starts_at:task?.planned_start ? `${task.planned_start}T09:00` : '' });
        renderCalendarBlocks();
      }

      function setTaskModalMode(meeting) {
        document.querySelectorAll('[data-task-only]').forEach((element) => element.classList.toggle('pm-hidden', meeting));
        document.querySelectorAll('[data-meeting-only]').forEach((element) => element.classList.toggle('pm-hidden', !meeting));
        document.getElementById('task-modal-title').textContent = meeting ? 'Detalle de reunión' : 'Detalle de tarea';
        document.getElementById('task-modal-context').textContent = meeting
          ? 'Gestiona un único evento, sus asistentes, responsables, compromisos y Notes by Gemini.'
          : 'Edita planificación, estado, insumos y documentos desde Lista o Cronograma.';
        document.getElementById('task-title-label').textContent = meeting ? 'Reunión' : 'Tarea';
        document.getElementById('task-start-label').textContent = meeting ? 'Fecha de reunión' : 'Inicio planificado';
        document.getElementById('task-description-label').textContent = meeting ? 'Agenda / propósito' : 'Descripción / notas';
        const statusSelect = document.getElementById('task-status');
        statusSelect.innerHTML = meeting
          ? '<option value="not_started">Programada</option><option value="in_progress">En curso</option><option value="completed">Realizada</option><option value="cancelled">Cancelada</option>'
          : '<option value="not_started">No iniciada</option><option value="ready">Lista</option><option value="in_progress">En curso</option><option value="blocked">Bloqueada</option><option value="in_review">En revisión</option><option value="completed">Completada</option><option value="cancelled">Cancelada</option>';
        refreshCustomSelect(statusSelect);
      }

      function defaultMeetingPeople() {
        const primaryContact = state.detail?.project?.primary_contact || {};
        const attendees = [{ id: crypto.randomUUID(), name: 'José Contreras', email: 'jose.contreras@rasika.cl', role: 'Rasika' }];
        if (primaryContact.full_name || primaryContact.email) attendees.push({ id: crypto.randomUUID(), name: primaryContact.full_name || '', email: primaryContact.email || '', role: 'Cliente' });
        return { attendees, responsibles: [attendees[0]] };
      }

      function normalizeMeetingPeople(items = []) {
        if (!Array.isArray(items)) return [];
        return items.map((item) => ({ id: item?.id || crypto.randomUUID(), name: item?.name || '', email: item?.email || '', role: item?.role || '' })).filter((item) => item.name || item.email);
      }

      function renderMeetingPeople(stateKey, containerId, emptyCopy) {
        const container = document.getElementById(containerId);
        const people = state[stateKey] || [];
        container.innerHTML = people.length ? people.map((person) => `<div class="pm-person-row" data-meeting-person-id="${escapeHTML(person.id)}"><input class="pm-input pm-input-compact" data-meeting-person-name value="${escapeHTML(person.name)}" maxlength="200" placeholder="Nombre" aria-label="Nombre"><input class="pm-input pm-input-compact" type="email" data-meeting-person-email value="${escapeHTML(person.email)}" maxlength="320" placeholder="correo@empresa.cl" aria-label="Correo"><input class="pm-input pm-input-compact" data-meeting-person-role value="${escapeHTML(person.role)}" maxlength="160" placeholder="Rol" aria-label="Rol"><button class="pm-icon-button" type="button" data-remove-meeting-person aria-label="Eliminar">×</button></div>`).join('') : `<div class="pm-placeholder-note">${escapeHTML(emptyCopy)}</div>`;
        container.querySelectorAll('[data-remove-meeting-person]').forEach((button) => button.addEventListener('click', () => {
          const id = button.closest('[data-meeting-person-id]').dataset.meetingPersonId;
          state[stateKey] = (state[stateKey] || []).filter((person) => person.id !== id);
          renderMeetingPeople(stateKey, containerId, emptyCopy);
        }));
      }

      function collectMeetingPeople(containerId) {
        return [...document.querySelectorAll(`#${containerId} [data-meeting-person-id]`)].map((row) => ({
          id: row.dataset.meetingPersonId,
          name: row.querySelector('[data-meeting-person-name]').value.trim(),
          email: row.querySelector('[data-meeting-person-email]').value.trim(),
          role: row.querySelector('[data-meeting-person-role]').value.trim(),
        })).filter((person) => person.name || person.email);
      }

      function addMeetingPerson(stateKey, containerId, role, emptyCopy) {
        state[stateKey].push({ id: crypto.randomUUID(), name: '', email: '', role });
        renderMeetingPeople(stateKey, containerId, emptyCopy);
        document.querySelector(`#${containerId} [data-meeting-person-id]:last-child [data-meeting-person-name]`)?.focus();
      }

      function renderMeetingCommitments() {
        const container = document.getElementById('meeting-commitments');
        container.innerHTML = state.editingMeetingCommitments.length ? state.editingMeetingCommitments.map((commitment) => `<div class="pm-commitment-row ${commitment.status === 'completed' ? 'is-complete' : ''}" data-meeting-commitment-id="${escapeHTML(commitment.id)}"><input type="checkbox" data-meeting-commitment-check ${commitment.status === 'completed' ? 'checked' : ''} aria-label="Compromiso completado"><input class="pm-input pm-input-compact" data-meeting-commitment-title value="${escapeHTML(commitment.title)}" maxlength="500" placeholder="Acuerdo o acción comprometida" aria-label="Compromiso"><input class="pm-input pm-input-compact" data-meeting-commitment-owner value="${escapeHTML(commitment.owner)}" maxlength="240" placeholder="Responsable" aria-label="Responsable"><input class="pm-input pm-input-compact" type="date" data-meeting-commitment-date value="${escapeHTML(commitment.due_date || '')}" aria-label="Fecha compromiso"><button class="pm-icon-button" type="button" data-remove-meeting-commitment aria-label="Eliminar compromiso">×</button></div>`).join('') : '<div class="pm-placeholder-note">Registra aquí acuerdos accionables, responsables y fechas comprometidas.</div>';
        container.querySelectorAll('[data-meeting-commitment-check]').forEach((checkbox) => checkbox.addEventListener('change', () => checkbox.closest('[data-meeting-commitment-id]').classList.toggle('is-complete', checkbox.checked)));
        container.querySelectorAll('[data-remove-meeting-commitment]').forEach((button) => button.addEventListener('click', () => {
          const id = button.closest('[data-meeting-commitment-id]').dataset.meetingCommitmentId;
          state.editingMeetingCommitments = state.editingMeetingCommitments.filter((commitment) => commitment.id !== id);
          renderMeetingCommitments();
        }));
      }

      function collectMeetingCommitments() {
        return [...document.querySelectorAll('#meeting-commitments [data-meeting-commitment-id]')].map((row) => ({
          id: row.dataset.meetingCommitmentId,
          title: row.querySelector('[data-meeting-commitment-title]').value.trim(),
          owner: row.querySelector('[data-meeting-commitment-owner]').value.trim(),
          due_date: row.querySelector('[data-meeting-commitment-date]').value || null,
