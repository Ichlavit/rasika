---
import '../styles/global.css';
import SEO from '../components/SEO.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const seo = {
  title: 'Project Control | Rasika',
  description: 'Panel privado de gestión de proyectos Rasika.',
  path: '/projects/',
  noindex: true,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260826c" />
    <link rel="alternate icon" href="/favicon.ico" />
    <SEO {...seo} />
    <style is:global>
      :root {
        --pm-bg: #0b0d0f;
        --pm-panel: #14171a;
        --pm-panel-2: #1b1f23;
        --pm-line: #2b3035;
        --pm-muted: #8f999f;
        --pm-text: #edf2f3;
        --pm-accent: #72bec7;
        --pm-accent-soft: #19383d;
        --pm-danger: #e78172;
        --pm-warning: #d8a25e;
        --pm-success: #6ec89b;
      }

      * { box-sizing: border-box; }
      body { min-width: 320px; background: var(--pm-bg); color: var(--pm-text); }
      button, input, select, textarea { font: inherit; }
      button { cursor: pointer; }
      .pm-hidden { display: none !important; }
      .pm-shell { min-height: 100vh; display: grid; grid-template-columns: 286px minmax(0, 1fr); transition: grid-template-columns .2s ease; }
      .pm-shell.sidebar-collapsed { grid-template-columns: 76px minmax(0, 1fr); }
      .pm-sidebar { border-right: 1px solid var(--pm-line); background: #101214; padding: 22px 16px; display: flex; flex-direction: column; min-width: 0; min-height: 100vh; overflow: hidden; transition: padding .2s ease; }
      .pm-brand { display: flex; align-items: center; gap: 11px; padding: 0 8px 24px; min-width: 0; }
      .pm-brand-mark { width: 34px; height: 34px; flex: 0 0 34px; display: grid; place-items: center; overflow: hidden; background: transparent; border-radius: 9px; }
      .pm-brand-mark img { width: 100%; height: 100%; object-fit: cover; }
      .pm-brand-copy { min-width: 0; flex: 1; }
      .pm-brand-copy strong { display: block; font-size: 14px; letter-spacing: .02em; }
      .pm-brand-copy span { display: block; color: var(--pm-muted); font-size: 11px; margin-top: 1px; }
      .pm-button.pm-sidebar-toggle { width: 28px; height: 28px; min-width: 28px; min-height: 28px; flex: 0 0 28px; display: grid; place-items: center; margin-left: auto; padding: 0; border-color: transparent; border-radius: 8px; color: #d9e0e3; background: #171a1d; }
      .pm-button.pm-sidebar-toggle:hover { border-color: #3a4248; background: #22272b; }
      .pm-sidebar-toggle svg { width: 13px; height: 13px; transition: transform .2s ease; }
      .pm-button { border: 1px solid var(--pm-line); color: var(--pm-text); background: var(--pm-panel-2); min-height: 40px; border-radius: 9px; padding: 9px 13px; font-weight: 700; font-size: 13px; }
      .pm-button:hover { border-color: #465057; background: #23282d; }
      .pm-button-primary { border-color: var(--pm-accent); background: var(--pm-accent); color: #071012; }
      .pm-button-primary:hover { background: #92d5dc; border-color: #92d5dc; }
      .pm-button-quiet { background: transparent; }
      .pm-button-danger { color: #f4aaa0; }
      .pm-button-push { margin-right: auto; }
      .pm-sidebar-tool { width:100%; margin-top:7px; }
      .pm-project-nav { margin-top: 24px; flex: 1; min-height: 0; }
      .pm-eyebrow { color: var(--pm-muted); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; font-weight: 800; }
      .pm-project-list { margin-top: 10px; display: grid; gap: 6px; overflow-y: auto; max-height: calc(100vh - 230px); }
      .pm-project-item { width: 100%; border: 1px solid transparent; background: transparent; color: inherit; text-align: left; border-radius: 9px; padding: 11px; }
      .pm-project-item:hover { background: #181b1e; }
      .pm-project-item.is-active { background: var(--pm-accent-soft); border-color: #2c5a60; }
      .pm-project-item strong { display: block; max-width: 100%; font-size: 13px; line-height: 1.35; white-space: normal; overflow-wrap: anywhere; }
      .pm-project-item span { display: flex; justify-content: space-between; gap: 8px; min-width: 0; color: var(--pm-muted); font-size: 10px; margin-top: 6px; }
      .pm-project-item span span { min-width: 0; margin-top: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .pm-project-item .pm-project-client { display: block; }
      .pm-project-item .pm-project-short { display: none; font-size: 10px; font-weight: 900; text-align: center; }
      .pm-sidebar-footer { border-top: 1px solid var(--pm-line); padding: 16px 8px 0; color: var(--pm-muted); font-size: 11px; }
      .pm-sidebar-footer a { color: var(--pm-accent); text-decoration: none; }
      .pm-main { min-width: 0; }
      .pm-shell.sidebar-collapsed .pm-sidebar { padding-inline: 10px; }
      .pm-shell.sidebar-collapsed .pm-brand { flex-direction: column; gap: 8px; padding: 0 0 14px; justify-content: center; }
      .pm-shell.sidebar-collapsed .pm-brand-copy,
      .pm-shell.sidebar-collapsed .pm-project-nav > .pm-eyebrow,
      .pm-shell.sidebar-collapsed .pm-sidebar-footer { display: none; }
      .pm-shell.sidebar-collapsed .pm-sidebar-toggle { position: static; margin-left: 0; }
      .pm-shell.sidebar-collapsed .pm-sidebar-toggle svg { transform: rotate(180deg); }
      .pm-shell.sidebar-collapsed #new-project-button { width: 44px; min-width: 44px; margin: 30px auto 0; padding: 0; font-size: 0; }
      .pm-shell.sidebar-collapsed #new-project-button::before { content: '+'; font-size: 20px; }
      .pm-shell.sidebar-collapsed .pm-sidebar-tool { width:44px; min-width:44px; margin-inline:auto; padding:0; font-size:0; }
      .pm-shell.sidebar-collapsed .pm-sidebar-tool::before { content:'◆'; font-size:14px; }
      .pm-shell.sidebar-collapsed .pm-project-nav { margin-top: 15px; }
      .pm-shell.sidebar-collapsed .pm-project-item { min-height: 44px; display: grid; place-items: center; padding: 7px 4px; }
      .pm-shell.sidebar-collapsed .pm-project-item > strong,
      .pm-shell.sidebar-collapsed .pm-project-item > span:not(.pm-project-short) { display: none; }
      .pm-shell.sidebar-collapsed .pm-project-short { display: block; }
      .pm-topbar { height: 74px; border-bottom: 1px solid var(--pm-line); display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 28px; background: #101214; }
      .pm-topbar h1 { margin: 0; font-size: 17px; }
      .pm-topbar p { margin: 3px 0 0; color: var(--pm-muted); font-size: 11px; }
      .pm-top-actions { display: flex; align-items: center; gap: 10px; }
      .pm-sync { display: flex; align-items: center; gap: 7px; color: var(--pm-muted); font-size: 11px; }
      .pm-sync-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--pm-warning); }
      .pm-sync.is-ready .pm-sync-dot { background: var(--pm-success); }
      .pm-content { padding: 24px 28px 40px; max-width: 1600px; margin: 0 auto; }
      .pm-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 18px; }
      .pm-metric { border: 1px solid var(--pm-line); background: var(--pm-panel); border-radius: 11px; padding: 16px; }
      .pm-metric span { display: block; color: var(--pm-muted); font-size: 11px; }
      .pm-metric strong { display: block; font-size: 25px; margin-top: 7px; letter-spacing: -.04em; }
      .pm-workspace { border: 1px solid var(--pm-line); background: var(--pm-panel); border-radius: 12px; overflow: hidden; }
      .pm-project-head { padding: 20px 22px 17px; display: flex; justify-content: space-between; gap: 18px; align-items: flex-start; border-bottom: 1px solid var(--pm-line); }
      .pm-project-head-actions { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 8px; }
      .pm-project-head h2 { margin: 4px 0 0; font-size: 22px; letter-spacing: -.025em; }
      .pm-project-meta { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 10px; color: var(--pm-muted); font-size: 11px; }
      .pm-chip { display: inline-flex; align-items: center; min-height: 25px; border: 1px solid #335e63; color: #a8e0e5; background: var(--pm-accent-soft); border-radius: 999px; padding: 3px 9px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
      .pm-tabs { display: flex; gap: 4px; padding: 8px 14px 0; border-bottom: 1px solid var(--pm-line); overflow-x: auto; }
      .pm-tab { border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--pm-muted); padding: 11px 12px; font-size: 12px; font-weight: 800; white-space: nowrap; }
      .pm-tab.is-active { color: var(--pm-text); border-bottom-color: var(--pm-accent); }
      .pm-panel { min-height: 420px; }
      .pm-timeline-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--pm-line); }
      .pm-timeline-toolbar strong { font-size: 12px; }
      .pm-timeline-toolbar span { color: var(--pm-muted); font-size: 11px; }
      .pm-timeline { min-width: 820px; }
      .pm-timeline-scroll { overflow-x: auto; }
      .pm-timeline-row { display: grid; grid-template-columns: 270px minmax(550px, 1fr); min-height: 43px; border-bottom: 1px solid #22272b; }
      .pm-timeline-row:last-child { border-bottom: 0; }
      .pm-timeline-label { position: sticky; left: 0; z-index: 5; padding: 10px 15px; border-right: 1px solid var(--pm-line); min-width: 0; background: #131619; box-shadow: 8px 0 12px -12px rgba(0, 0, 0, .9); }
      .pm-timeline-label strong { display: block; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .pm-timeline-label span { display: block; color: var(--pm-muted); font-size: 9px; margin-top: 2px; }
      .pm-timeline-axis { position: relative; overflow: hidden; background: #131619; }
      .pm-axis-grid { position: absolute; inset: 0; display: grid; pointer-events: none; z-index: 0; }
      .pm-axis-grid span { border-left: 1px solid rgba(255, 255, 255, .055); }
      .pm-axis-grid span:last-child { border-right: 1px solid rgba(255, 255, 255, .055); }
      .pm-today-marker { position: absolute; top: 0; bottom: 0; width: 2px; transform: translateX(-1px); background: var(--pm-accent); box-shadow: 0 0 8px rgba(114, 190, 199, .5); pointer-events: none; z-index: 3; }
      .pm-today-marker.is-header::after { content: attr(data-today-label); position: absolute; top: 5px; left: 50%; transform: translateX(-50%); border-radius: 999px; padding: 3px 7px; color: #071012; background: var(--pm-accent); box-shadow: 0 2px 8px rgba(0, 0, 0, .28); font-size: 8px; font-weight: 900; line-height: 1; white-space: nowrap; }
      .pm-timeline-header { min-height: 36px; background: #111416; }
      .pm-timeline-header .pm-timeline-label { z-index: 7; color: var(--pm-muted); font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; background: #111416; }
      .pm-axis-labels { position: relative; z-index: 4; display: grid; height: 100%; align-items: center; color: var(--pm-muted); font-size: 9px; padding: 0; }
      .pm-axis-labels span { padding-left: 7px; white-space: nowrap; }
      .pm-axis-labels span:last-child { text-align: right; }
      .pm-department-row { min-height: 34px; background: #171a1d; }
      .pm-department-row .pm-timeline-label { z-index: 6; display: flex; align-items: center; gap: 8px; padding-top: 7px; padding-bottom: 7px; background: #171a1d; }
      .pm-department-dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 auto; }
      .pm-department-toggle { width: 100%; display: flex; align-items: center; gap: 8px; border: 0; background: transparent; color: inherit; padding: 0; text-align: left; }
      .pm-department-toggle-icon { width: 12px; color: var(--pm-muted); font-size: 9px; text-align: center; }
      .pm-department-count { margin-left: auto; color: var(--pm-muted); font-size: 9px; }
      .pm-task-bar { position: absolute; top: 9px; z-index: 1; height: 24px; min-width: 8px; border: 0; border-radius: 6px; background: var(--department-color, var(--pm-accent)); color: #071012; display: flex; align-items: center; padding: 0 8px; overflow: hidden; font-size: 9px; font-weight: 900; white-space: nowrap; box-shadow: inset 0 -1px rgba(0, 0, 0, .2); transform: translateX(var(--pm-drag-offset, 0px)); touch-action: none; }
      .pm-task-bar:hover { filter: brightness(1.12); z-index: 2; }
      .pm-task-bar.is-draggable { cursor: grab; }
      .pm-task-bar.is-dragging { cursor: grabbing; filter: brightness(1.12); z-index: 4; }
      .pm-task-bar.is-selected { outline: 2px solid #d8f8fa; outline-offset: 2px; }
      .pm-task-bar.is-completed { opacity: .58; box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .34); }
      .pm-task-bar.is-blocked { box-shadow: inset 0 0 0 2px var(--pm-danger), 0 0 0 1px rgba(0, 0, 0, .35); }
      .pm-task-bar.is-milestone { width: 17px !important; min-width: 17px; height: 17px; top: 13px; border-radius: 3px; transform: translateX(var(--pm-drag-offset, 0px)) rotate(45deg); padding: 0; }
      .pm-task-bar.is-meeting { box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .58), 0 0 0 1px rgba(0, 0, 0, .34); }
      .pm-department-summary { top: 7px; height: 20px; opacity: .82; border-radius: 999px; }
      .pm-timeline-task-link { width: 100%; border: 0; background: transparent; color: inherit; padding: 0; text-align: left; }
      .pm-timeline-task-link:hover strong { color: var(--pm-accent); }
      .pm-empty { padding: 64px 24px; text-align: center; }
      .pm-empty strong { display: block; font-size: 16px; }
      .pm-empty p { color: var(--pm-muted); font-size: 12px; max-width: 470px; margin: 10px auto 0; }
      .pm-list-toolbar { display: flex; justify-content: space-between; align-items: end; gap: 14px; padding: 14px 18px; border-bottom: 1px solid var(--pm-line); }
      .pm-list-toolbar-copy strong { display: block; font-size: 12px; }
      .pm-list-toolbar-copy span { display: block; color: var(--pm-muted); font-size: 10px; margin-top: 3px; }
      .pm-list-controls { display: flex; align-items: end; gap: 8px; }
      .pm-list-control { display: grid; gap: 4px; }
      .pm-list-control label { color: var(--pm-muted); font-size: 8px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
      .pm-input-compact { min-height: 34px; padding: 6px 9px; font-size: 10px; }
      .pm-task-group-row td { padding: 9px 14px; background: #171a1d; }
      .pm-task-group-heading { display: flex; align-items: center; gap: 8px; font-size: 10px; font-weight: 900; }
      .pm-task-group-heading span:last-child { color: var(--pm-muted); font-weight: 700; }
      .pm-task-open { border: 0; background: transparent; color: var(--pm-text); padding: 0; text-align: left; font-weight: 800; }
      .pm-task-open:hover { color: var(--pm-accent); }
      .pm-task-subline { display: block; color: var(--pm-muted); font-size: 9px; margin-top: 3px; }
      .pm-status-pill { display: inline-flex; align-items: center; min-height: 23px; padding: 3px 8px; border-radius: 999px; background: #20262a; color: #cbd2d5; font-size: 9px; font-weight: 800; }
      .pm-progress-track { width: 72px; height: 5px; border-radius: 999px; overflow: hidden; background: #2c3237; }
      .pm-progress-track span { display: block; height: 100%; background: var(--department-color, var(--pm-accent)); }
      .pm-document-options { border: 1px solid #353c41; border-radius: 9px; max-height: 180px; overflow-y: auto; background: #101315; }
      .pm-document-option { display: grid; grid-template-columns: 18px 1fr; gap: 9px; align-items: start; padding: 10px 11px; border-bottom: 1px solid #252a2e; }
      .pm-document-option:last-child { border-bottom: 0; }
      .pm-document-option strong { display: block; font-size: 10px; }
      .pm-document-option span { display: block; color: var(--pm-muted); font-size: 9px; margin-top: 2px; }
      .pm-table-wrap { overflow-x: auto; }
      .pm-table { width: 100%; border-collapse: collapse; font-size: 11px; }
      .pm-table th { color: var(--pm-muted); font-size: 9px; letter-spacing: .09em; text-transform: uppercase; text-align: left; background: #111416; }
      .pm-table th, .pm-table td { padding: 12px 16px; border-bottom: 1px solid var(--pm-line); }
      .pm-table tr:last-child td { border-bottom: 0; }
      .pm-minutes { padding: 18px; display: grid; gap: 14px; }
      .pm-minutes-hero { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; border: 1px solid #35565b; border-radius: 11px; padding: 16px; background: linear-gradient(135deg, #173238, #151a1d 64%); }
      .pm-minutes-hero h3 { margin: 4px 0 0; font-size: 17px; }
      .pm-minutes-hero p { max-width: 700px; margin: 7px 0 0; color: #a7b0b4; font-size: 11px; }
      .pm-minutes-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px; }
      .pm-minutes-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; }
      .pm-minute-stat { border: 1px solid var(--pm-line); border-radius: 9px; padding: 12px; background: #111416; }
      .pm-minute-stat span { display: block; color: var(--pm-muted); font-size: 9px; text-transform: uppercase; letter-spacing: .06em; }
      .pm-minute-stat strong { display: block; margin-top: 4px; font-size: 18px; }
      .pm-minute-knowledge { display: flex; align-items: flex-start; gap: 11px; padding: 13px 14px; border: 1px solid var(--pm-line); border-radius: 9px; background: #111416; }
      .pm-minute-knowledge-icon { width: 30px; height: 30px; flex: 0 0 30px; display: grid; place-items: center; border-radius: 8px; color: var(--pm-accent); background: var(--pm-accent-soft); }
      .pm-minute-knowledge strong { display: block; font-size: 11px; }
      .pm-minute-knowledge p { margin: 4px 0 0; color: var(--pm-muted); font-size: 10px; }
      .pm-minute-list { display: grid; gap: 8px; }
      .pm-minute-card { display: grid; grid-template-columns: 78px minmax(0, 1fr) auto; align-items: center; gap: 12px; min-height: 74px; padding: 12px; border: 1px solid var(--pm-line); border-radius: 10px; background: #111416; }
      .pm-minute-date { display: grid; place-items: center; align-content: center; min-height: 48px; border-radius: 8px; color: var(--pm-text); background: #1c2226; text-align: center; }
      .pm-minute-date strong { display: block; font-size: 12px; }
      .pm-minute-date span { display: block; color: var(--pm-muted); font-size: 8px; margin-top: 2px; }
      .pm-minute-copy { min-width: 0; }
      .pm-minute-copy h4 { display: flex; align-items: center; gap: 7px; margin: 0; font-size: 11px; }
      .pm-minute-copy p { margin: 5px 0 0; color: var(--pm-muted); font-size: 9px; }
      .pm-minute-meta { display: flex; flex-wrap: wrap; gap: 5px 10px; margin-top: 7px; color: #aab3b7; font-size: 9px; }
      .pm-minute-card-actions { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 6px; }
      .pm-agent-ready { color: var(--pm-success); background: #173026; }
      .pm-agent-pending { color: var(--pm-warning); background: #302719; }
      .pm-minutes-message { min-height: 16px; margin: 0; color: var(--pm-warning); font-size: 10px; }
      .pm-modal-backdrop { position: fixed; inset: 0; z-index: 80; background: rgba(3, 5, 6, .78); display: grid; place-items: center; padding: 22px; }
      .pm-modal { width: min(820px, 100%); max-height: calc(100vh - 44px); display: flex; flex-direction: column; overflow: hidden; background: var(--pm-panel-2); border: 1px solid #3a4248; border-radius: 14px; box-shadow: 0 24px 80px rgba(0, 0, 0, .52); }
      .pm-modal-head { flex: 0 0 auto; display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; padding: 18px 20px; border-bottom: 1px solid var(--pm-line); }
      .pm-modal-head h2 { margin: 0; font-size: 18px; }
      .pm-modal-head p { margin: 5px 0 0; color: var(--pm-muted); font-size: 11px; }
      .pm-modal-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 18px 20px; }
      .pm-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
      .pm-field { display: grid; gap: 6px; }
      .pm-field-full { grid-column: 1 / -1; }
      .pm-three-grid { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
      .pm-field label { color: #cbd2d5; font-size: 10px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
      .pm-input { width: 100%; min-height: 42px; border: 1px solid #353c41; border-radius: 8px; color: var(--pm-text); background: #101315; padding: 9px 11px; outline: none; }
      .pm-input:focus { border-color: var(--pm-accent); }
      input[type="number"].pm-input { appearance: textfield; -moz-appearance: textfield; }
      input[type="number"].pm-input::-webkit-inner-spin-button,
      input[type="number"].pm-input::-webkit-outer-spin-button { appearance: none; -webkit-appearance: none; margin: 0; }
      .pm-native-select { position: absolute !important; width: 1px !important; height: 1px !important; min-height: 1px !important; opacity: 0; pointer-events: none; }
      .pm-select { position: relative; min-width: 0; }
      .pm-select-button { width: 100%; min-height: 42px; display: flex; align-items: center; justify-content: space-between; gap: 10px; border: 1px solid #353c41; border-radius: 8px; color: var(--pm-text); background: #101315; padding: 9px 11px; text-align: left; }
      .pm-select-button:hover, .pm-select.is-open .pm-select-button { border-color: var(--pm-accent); }
      .pm-select-button svg { width: 14px; height: 14px; flex: 0 0 auto; color: var(--pm-muted); transition: transform .16s ease; }
      .pm-select.is-open .pm-select-button svg { transform: rotate(180deg); }
      .pm-select-menu { position: absolute; z-index: 120; top: calc(100% + 5px); left: 0; right: 0; display: none; max-height: 230px; overflow-y: auto; padding: 5px; border: 1px solid #3b454b; border-radius: 9px; background: #111518; box-shadow: 0 16px 38px rgba(0, 0, 0, .48); }
      .pm-select.is-open .pm-select-menu { display: grid; }
      .pm-select-option { width: 100%; border: 0; border-radius: 6px; color: var(--pm-text); background: transparent; padding: 9px 10px; text-align: left; font-size: 12px; }
      .pm-select-option:hover, .pm-select-option.is-selected { color: #071012; background: var(--pm-accent); }
      .pm-select.pm-input-compact .pm-select-button { min-height: 34px; padding: 6px 9px; font-size: 10px; }
      textarea.pm-input { min-height: 92px; resize: vertical; }
      .pm-service-options { border: 1px solid #353c41; border-radius: 9px; max-height: 220px; overflow-y: auto; background: #101315; }
      .pm-service-option { display: grid; grid-template-columns: 18px 1fr auto; gap: 10px; align-items: center; padding: 11px; border-bottom: 1px solid #252a2e; }
      .pm-service-option:last-child { border-bottom: 0; }
      .pm-service-option strong { display: block; font-size: 11px; }
      .pm-service-option span { display: block; color: var(--pm-muted); font-size: 9px; margin-top: 2px; }
      .pm-template-badge { color: var(--pm-success) !important; font-weight: 800; }
      .pm-template-badge.is-missing { color: var(--pm-warning) !important; }
      .pm-form-message { min-height: 18px; margin: 14px 0 0; color: var(--pm-danger); font-size: 11px; }
      .pm-modal-actions { flex: 0 0 auto; display: flex; justify-content: flex-end; gap: 8px; padding: 16px 22px; border-top: 1px solid var(--pm-line); background: var(--pm-panel-2); }
      .pm-section-title { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 7px; }
      .pm-section-title > label { margin: 0; }
      .pm-inline-actions { display: flex; flex-wrap: wrap; gap: 6px; }
      .pm-calendar-actions { display: flex; align-items: center; gap: 6px; }
      .pm-calendar-actions-stack { display: flex; flex-direction: column; flex-wrap: nowrap; align-items: stretch; gap: 6px; }
      .pm-calendar-actions-stack > .pm-button { width: 100%; justify-content: center; }
      .pm-checklist, .pm-integration-card { border: 1px solid #353c41; border-radius: 9px; background: #101315; overflow: hidden; }
      .pm-check-row { display: grid; grid-template-columns: 18px minmax(0, 1fr) auto; align-items: center; gap: 9px; min-height: 42px; padding: 8px 10px; border-bottom: 1px solid #252a2e; }
      .pm-check-row:last-child { border-bottom: 0; }
      .pm-check-row input[type="text"] { width: 100%; min-width: 0; border: 0; color: var(--pm-text); background: transparent; outline: none; font-size: 11px; }
      .pm-check-row input[type="checkbox"] { accent-color: var(--pm-accent); }
      .pm-check-row.is-complete .pm-check-label { color: var(--pm-muted); text-decoration: line-through; }
      .pm-icon-button { width: 28px; height: 28px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 7px; color: var(--pm-muted); background: transparent; }
      .pm-icon-button:hover { color: var(--pm-danger); background: #272c30; }
      .pm-integration-head { display: flex; justify-content: space-between; gap: 12px; align-items: center; padding: 11px 12px; border-bottom: 1px solid #252a2e; }
      .pm-integration-head strong { display: block; font-size: 11px; }
      .pm-integration-head span { display: block; color: var(--pm-muted); font-size: 9px; margin-top: 3px; }
      .pm-file-row, .pm-calendar-row { display: grid; align-items: center; gap: 10px; padding: 10px 12px; border-bottom: 1px solid #252a2e; }
      .pm-file-row { grid-template-columns: 24px minmax(0, 1fr) auto; }
      .pm-calendar-row { grid-template-columns: 44px minmax(0, 1fr) minmax(150px, 180px) auto; }
      .pm-file-row:last-child, .pm-calendar-row:last-child { border-bottom: 0; }
      .pm-file-icon { width: 24px; height: 24px; display: grid; place-items: center; border-radius: 6px; background: #20353a; color: var(--pm-accent); font-size: 12px; }
      .pm-file-copy, .pm-calendar-copy { min-width: 0; }
      .pm-file-copy strong, .pm-calendar-copy strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 10px; }
      .pm-file-copy span, .pm-calendar-copy span { display: block; color: var(--pm-muted); font-size: 9px; margin-top: 2px; }
      .pm-hours-badge { display: grid; place-items: center; min-height: 28px; border-radius: 7px; color: #071012; background: var(--pm-accent); font-size: 10px; font-weight: 900; }
      .pm-calendar-schedule { display: grid; gap: 6px; min-width: 0; }
      .pm-calendar-schedule .pm-input { width: 100%; min-width: 0; }
      .pm-calendar-picker { margin-top: 9px; border: 1px solid #35565b; border-radius: 10px; background: #101719; overflow: hidden; }
      .pm-calendar-picker-head { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 8px; align-items: center; padding: 10px; border-bottom: 1px solid #26363a; }
      .pm-calendar-event-list { max-height: 290px; overflow-y: auto; }
      .pm-calendar-event-option { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 11px 12px; border-bottom: 1px solid #252f32; }
      .pm-calendar-event-option:last-child { border-bottom: 0; }
      .pm-calendar-event-option strong { display: block; font-size: 11px; }
      .pm-calendar-event-option span { display: block; margin-top: 3px; color: var(--pm-muted); font-size: 9px; }
      .pm-placeholder-note { padding: 12px; color: var(--pm-muted); font-size: 10px; }
      .pm-drive-browser { overflow: hidden; border: 1px solid var(--pm-line); border-radius: 10px; background: #101315; }
      .pm-drive-browser-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 14px; border-bottom: 1px solid var(--pm-line); background: var(--pm-panel-2); }
      .pm-drive-browser-head strong, .pm-drive-tree-copy strong { display: block; font-size: 11px; }
      .pm-drive-browser-head span, .pm-drive-tree-copy span { display: block; margin-top: 3px; color: var(--pm-muted); font-size: 9px; }
      .pm-drive-browser-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px; }
      .pm-drive-tree-row { display: grid; grid-template-columns: minmax(0, 1fr) 130px 130px auto; align-items: center; gap: 12px; min-height: 48px; padding: 8px 12px 8px calc(12px + var(--drive-depth, 0) * 20px); border-bottom: 1px solid #252a2e; }
      .pm-drive-tree-row:last-child { border-bottom: 0; }
      .pm-drive-tree-row.is-folder { background: #121719; }
      .pm-drive-tree-name { min-width: 0; display: grid; grid-template-columns: 24px 24px minmax(0, 1fr); align-items: center; gap: 7px; }
      .pm-drive-tree-toggle, .pm-drive-tree-spacer { width: 24px; height: 24px; }
      .pm-drive-tree-toggle { display: grid; place-items: center; border: 0; border-radius: 6px; color: var(--pm-muted); background: transparent; cursor: pointer; }
      .pm-drive-tree-toggle:hover { color: var(--pm-text); background: #232a2e; }
      .pm-drive-tree-icon { width: 24px; height: 24px; display: grid; place-items: center; border-radius: 6px; color: var(--pm-accent); background: #20353a; font-size: 12px; }
      .pm-drive-tree-copy { min-width: 0; }
      .pm-drive-tree-copy a { display: block; overflow: hidden; color: inherit; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
      .pm-drive-tree-copy a:hover { color: var(--pm-accent); }
      .pm-drive-tree-meta { color: var(--pm-muted); font-size: 9px; }
      .pm-drive-sync-message { min-height: 18px; margin: 8px 0 0; color: var(--pm-muted); font-size: 10px; }
      .pm-person-row { display: grid; grid-template-columns: minmax(130px, 1fr) minmax(170px, 1.2fr) minmax(120px, .8fr) 28px; align-items: center; gap: 8px; padding: 9px 10px; border-bottom: 1px solid #252a2e; }
      .pm-person-row:last-child, .pm-commitment-row:last-child { border-bottom: 0; }
      .pm-person-row input, .pm-commitment-row input[type="text"], .pm-commitment-row input[type="date"] { min-width: 0; min-height: 34px; }
      .pm-commitment-row { display: grid; grid-template-columns: 18px minmax(180px, 1.6fr) minmax(130px, .8fr) 140px 28px; align-items: center; gap: 8px; padding: 9px 10px; border-bottom: 1px solid #252a2e; }
      .pm-commitment-row input[type="checkbox"] { accent-color: var(--pm-accent); }
      .pm-commitment-row.is-complete input[type="text"] { color: var(--pm-muted); text-decoration: line-through; }
      .pm-meeting-note { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; align-items: center; gap: 11px; padding: 12px; }
      .pm-meeting-note-icon { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 8px; color: var(--pm-accent); background: var(--pm-accent-soft); font-weight: 900; }
      .pm-meeting-note strong { display: block; font-size: 11px; }
      .pm-meeting-note span { display: block; margin-top: 3px; color: var(--pm-muted); font-size: 9px; }
      .pm-share-summary { border: 1px solid #35565b; border-radius: 10px; padding: 13px; background: #11191c; }
      .pm-share-summary strong { display: block; font-size: 11px; }
      .pm-share-summary p { margin: 5px 0 0; color: var(--pm-muted); font-size: 10px; line-height: 1.5; }
      .pm-share-url { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
      .pm-department-manager { display:grid; gap:9px; margin-top:16px; }
      .pm-department-manager-row { display:grid; grid-template-columns:42px minmax(150px,1fr) minmax(155px,.9fr) auto auto; align-items:center; gap:9px; padding:10px; border:1px solid #353c41; border-radius:9px; background:#101315; }
      .pm-color-input { width:42px; height:36px; padding:3px; border:1px solid #353c41; border-radius:8px; background:#101315; }
      .pm-department-usage strong { display:block; font-size:10px; }
      .pm-department-usage span { display:block; margin-top:3px; color:var(--pm-muted); font-size:9px; }
      .pm-department-replacement { grid-column:2 / 4; }
      .pm-link-button { color: var(--pm-accent); text-decoration: none; }
      .pm-link-button[aria-disabled="true"] { color: var(--pm-muted); pointer-events: none; opacity: .7; }
      .pm-auth { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
      .pm-auth-card { width: min(410px, 100%); border: 1px solid var(--pm-line); background: var(--pm-panel); border-radius: 14px; padding: 28px; }
      .pm-auth-card .pm-brand { padding-left: 0; }
      .pm-auth-card h1 { margin: 0; font-size: 23px; }
      .pm-auth-card > p { color: var(--pm-muted); font-size: 12px; margin: 8px 0 22px; }
      .pm-auth-card form { display: grid; gap: 12px; }
      .pm-loading { opacity: .62; pointer-events: none; }
      .pm-mobile-menu { display: none; }

      @media (max-width: 980px) {
        .pm-shell { grid-template-columns: 1fr; }
        .pm-shell.sidebar-collapsed { grid-template-columns: 1fr; }
        .pm-sidebar { position: fixed; inset: 0 auto 0 0; width: 286px; z-index: 60; transform: translateX(-100%); transition: transform .2s ease; }
        .pm-shell.sidebar-open .pm-sidebar { transform: translateX(0); }
        .pm-mobile-menu { display: inline-flex; }
        .pm-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .pm-sidebar-toggle { display: none; }
        .pm-shell.sidebar-collapsed .pm-sidebar { padding: 22px 16px; }
        .pm-shell.sidebar-collapsed .pm-brand { flex-direction: row; gap: 11px; padding: 0 8px 24px; justify-content: flex-start; }
        .pm-shell.sidebar-collapsed .pm-brand-copy,
        .pm-shell.sidebar-collapsed .pm-project-nav > .pm-eyebrow,
        .pm-shell.sidebar-collapsed .pm-sidebar-footer { display: block; }
        .pm-shell.sidebar-collapsed #new-project-button { width: 100%; margin: 0; padding: 9px 13px; font-size: 13px; }
        .pm-shell.sidebar-collapsed #new-project-button::before { content: none; }
        .pm-shell.sidebar-collapsed .pm-sidebar-tool { width:100%; margin-top:7px; padding:9px 13px; font-size:13px; }
        .pm-shell.sidebar-collapsed .pm-sidebar-tool::before { content:none; }
        .pm-shell.sidebar-collapsed .pm-project-nav { margin-top: 24px; }
        .pm-shell.sidebar-collapsed .pm-project-item { display: block; min-height: 0; padding: 11px; }
        .pm-shell.sidebar-collapsed .pm-project-item > strong,
        .pm-shell.sidebar-collapsed .pm-project-item > span:not(.pm-project-short) { display: flex; }
        .pm-shell.sidebar-collapsed .pm-project-item > strong { display: block; }
        .pm-shell.sidebar-collapsed .pm-project-short { display: none; }
      }

      @media (max-width: 640px) {
        .pm-topbar { padding: 0 16px; }
        .pm-content { padding: 16px; }
        .pm-metrics { grid-template-columns: 1fr 1fr; }
        .pm-project-head { flex-direction: column; }
        .pm-project-head-actions { justify-content: flex-start; }
        .pm-form-grid { grid-template-columns: 1fr; }
        .pm-field-full { grid-column: auto; }
        .pm-three-grid { grid-column: auto; grid-template-columns: 1fr; }
        .pm-sync { display: none; }
        .pm-list-toolbar { align-items: stretch; flex-direction: column; }
        .pm-list-controls { align-items: stretch; }
        .pm-list-control { flex: 1; }
        .pm-calendar-row { grid-template-columns: 40px minmax(0, 1fr); }
        .pm-calendar-row .pm-select, .pm-calendar-row > :last-child { grid-column: 2; }
        .pm-calendar-picker-head { grid-template-columns: 1fr auto; }
        .pm-calendar-picker-head input { grid-column: 1 / -1; }
        .pm-drive-browser-head { align-items: stretch; flex-direction: column; }
        .pm-drive-browser-actions { justify-content: flex-start; }
        .pm-drive-tree-row { grid-template-columns: minmax(0, 1fr) auto; }
        .pm-drive-tree-row > .pm-drive-tree-meta { display: none; }
        .pm-minutes-hero { flex-direction: column; }
        .pm-minutes-actions { justify-content: flex-start; }
        .pm-minutes-stats { grid-template-columns: 1fr; }
        .pm-minute-card { grid-template-columns: 64px minmax(0, 1fr); }
        .pm-minute-card-actions { grid-column: 2; justify-content: flex-start; }
        .pm-person-row { grid-template-columns: 1fr 28px; }
        .pm-person-row input:not(:first-child) { grid-column: 1; }
        .pm-commitment-row { grid-template-columns: 18px 1fr 28px; }
        .pm-commitment-row input[data-meeting-commitment-owner], .pm-commitment-row input[data-meeting-commitment-date] { grid-column: 2; }
        .pm-meeting-note { grid-template-columns: 34px minmax(0, 1fr); }
        .pm-meeting-note > :last-child { grid-column: 2; }
        .pm-share-url { grid-template-columns: 1fr; }
        .pm-department-manager-row { grid-template-columns:42px minmax(0,1fr) auto; }
        .pm-department-usage, .pm-department-replacement { grid-column:2 / 4; }
      }
    </style>
  </head>
  <body>
    <div id="projects-config" hidden data-url={supabaseUrl} data-key={supabaseAnonKey}></div>

    <section id="projects-auth" class="pm-auth">
      <div class="pm-auth-card">
        <div class="pm-brand">
          <span class="pm-brand-mark"><img src="/favicon.svg?v=20260826c" alt="" /></span>
          <span class="pm-brand-copy"><strong>Rasika</strong><span>Project Control</span></span>
        </div>
        <h1>Gestión de proyectos</h1>
        <p>Área privada conectada al CRM y al catálogo de servicios.</p>
        <form id="projects-login-form">
          <div class="pm-field">
            <label for="projects-email">Correo</label>
            <input class="pm-input" id="projects-email" type="email" autocomplete="username" required value="jose.contreras@rasika.cl" />
          </div>
          <div class="pm-field">
            <label for="projects-password">Contraseña</label>
            <input class="pm-input" id="projects-password" type="password" autocomplete="current-password" required />
          </div>
          <p id="projects-login-error" class="pm-form-message" role="alert"></p>
          <button class="pm-button pm-button-primary" type="submit">Ingresar</button>
        </form>
      </div>
    </section>

    <div id="projects-app" class="pm-shell pm-hidden">
      <aside class="pm-sidebar">
        <div class="pm-brand">
          <span class="pm-brand-mark"><img src="/favicon.svg?v=20260826c" alt="" /></span>
          <span class="pm-brand-copy"><strong>Rasika</strong><span>Project Control</span></span>
          <button id="sidebar-toggle" class="pm-button pm-button-quiet pm-sidebar-toggle" type="button" aria-label="Contraer barra lateral" aria-expanded="true">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12.5 4.5-5 5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
        <button id="new-project-button" class="pm-button pm-button-primary" type="button">＋ Nuevo proyecto</button>
        <button id="manage-departments-button" class="pm-button pm-button-quiet pm-sidebar-tool" type="button">◆ Departamentos</button>
        <nav class="pm-project-nav" aria-label="Proyectos">
          <span class="pm-eyebrow">Proyectos</span>
          <div id="project-list" class="pm-project-list"></div>
        </nav>
        <div class="pm-sidebar-footer">
          <span id="profile-name">Acceso privado</span><br />
          <a href="/admin/">Volver al CMS</a>
        </div>
      </aside>

      <main class="pm-main">
        <header class="pm-topbar">
          <div style="display:flex;align-items:center;gap:12px;min-width:0">
            <button id="mobile-menu" class="pm-button pm-button-quiet pm-mobile-menu" type="button" aria-label="Abrir navegación">☰</button>
            <div>
              <h1>Portafolio de proyectos</h1>
              <p>CRM · Servicios · Planificación operacional</p>
            </div>
          </div>
          <div class="pm-top-actions">
            <span id="sync-status" class="pm-sync"><span class="pm-sync-dot"></span><span>Conectando</span></span>
            <button id="refresh-projects" class="pm-button pm-button-quiet" type="button">Actualizar</button>
            <button id="projects-logout" class="pm-button pm-button-quiet pm-button-danger" type="button">Salir</button>
          </div>
        </header>

        <div class="pm-content">
          <section id="project-metrics" class="pm-metrics" aria-label="Resumen"></section>

          <section class="pm-workspace">
            <div id="project-heading" class="pm-project-head"></div>
            <div class="pm-tabs" role="tablist">
              <button class="pm-tab is-active" type="button" data-tab="timeline">Cronograma</button>
              <button class="pm-tab" type="button" data-tab="task-list">Lista</button>
              <button class="pm-tab" type="button" data-tab="services">Servicios y eficiencia</button>
              <button class="pm-tab" type="button" data-tab="documents">Documentos</button>
              <button class="pm-tab" type="button" data-tab="minutes">Minutas</button>
              <button class="pm-tab" type="button" data-tab="activity">Actividad</button>
            </div>
            <div id="timeline-panel" class="pm-panel" data-panel="timeline"></div>
            <div id="task-list-panel" class="pm-panel pm-hidden" data-panel="task-list"></div>
            <div id="services-panel" class="pm-panel pm-hidden" data-panel="services"></div>
            <div id="documents-panel" class="pm-panel pm-hidden" data-panel="documents"></div>
            <div id="minutes-panel" class="pm-panel pm-hidden" data-panel="minutes"></div>
            <div id="activity-panel" class="pm-panel pm-hidden" data-panel="activity"></div>
          </section>
        </div>
      </main>
    </div>

    <div id="project-modal" class="pm-modal-backdrop pm-hidden" role="dialog" aria-modal="true" aria-labelledby="project-modal-title">
      <form id="new-project-form" class="pm-modal">
        <div class="pm-modal-head">
          <div>
            <h2 id="project-modal-title">Crear proyecto</h2>
            <p>Vincula un cliente real del CRM y uno o más servicios Rasika.</p>
          </div>
          <button id="close-project-modal" class="pm-button pm-button-quiet" type="button" aria-label="Cerrar">×</button>
        </div>
        <div class="pm-modal-body">
          <div class="pm-form-grid">
            <div class="pm-field pm-field-full">
              <label for="project-name">Nombre del proyecto</label>
              <input id="project-name" class="pm-input" required maxlength="240" placeholder="Ej. Programa de inducción 2026" />
            </div>
            <div class="pm-field">
              <label for="project-organization">Cliente CRM</label>
              <select id="project-organization" class="pm-input" required></select>
            </div>
            <div class="pm-field">
              <label for="project-contact">Contacto principal</label>
              <select id="project-contact" class="pm-input" required></select>
            </div>
            <div class="pm-field">
              <label for="project-start">Inicio planificado</label>
              <input id="project-start" class="pm-input" type="date" required />
            </div>
            <div class="pm-field">
              <label for="project-end">Compromiso de entrega</label>
              <input id="project-end" class="pm-input" type="date" required />
            </div>
            <div class="pm-field">
              <label for="project-days">Días laborales estimados</label>
              <input id="project-days" class="pm-input" type="number" min="0" step="0.5" />
            </div>
            <div class="pm-field">
              <label for="project-priority">Prioridad</label>
              <select id="project-priority" class="pm-input">
                <option value="normal">Normal</option>
                <option value="high">Alta</option>
                <option value="urgent">Urgente</option>
                <option value="low">Baja</option>
              </select>
            </div>
            <div class="pm-field pm-field-full">
              <label>Servicios / componentes del proyecto</label>
              <div id="project-service-options" class="pm-service-options"></div>
            </div>
          </div>
          <p id="project-form-message" class="pm-form-message" role="alert"></p>
        </div>
        <div class="pm-modal-actions">
          <button id="cancel-project" class="pm-button pm-button-quiet" type="button">Cancelar</button>
          <button id="submit-project" class="pm-button pm-button-primary" type="submit">Crear proyecto</button>
        </div>
      </form>
    </div>

    <div id="task-modal" class="pm-modal-backdrop pm-hidden" role="dialog" aria-modal="true" aria-labelledby="task-modal-title">
      <form id="task-edit-form" class="pm-modal">
        <div class="pm-modal-head">
          <div>
            <h2 id="task-modal-title">Detalle de tarea</h2>
            <p id="task-modal-context">Edita planificación, estado, insumos y documentos desde Lista o Cronograma.</p>
          </div>
          <button id="close-task-modal" class="pm-button pm-button-quiet" type="button" aria-label="Cerrar">×</button>
        </div>
