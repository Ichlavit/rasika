      async function loadProjects(preferredProjectId = null) {
        setSyncStatus('Actualizando');
        try {
          state.bootstrap = await projectRequest('?resource=bootstrap');
          document.getElementById('profile-name').textContent = state.bootstrap.profile?.full_name || state.bootstrap.profile?.email || 'Acceso privado';
          renderMetrics();
