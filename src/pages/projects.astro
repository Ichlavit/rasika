            method: 'POST',
            headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY },
            body: JSON.stringify({
              email: document.getElementById('projects-email').value,
              password: document.getElementById('projects-password').value,
            }),
          });
          const result = await response.json();
          if (!response.ok || !result.access_token) throw new Error(result.error_description || result.msg || 'Credenciales incorrectas.');
          sessionStorage.setItem('adminToken', result.access_token);
          showProjectsApp();
          await loadProjects();
