        state.editingMeetingCommitments.push({ id: crypto.randomUUID(), title: '', owner: '', due_date: '', status: 'pending' });
        renderMeetingCommitments();
        document.querySelector('#meeting-commitments [data-meeting-commitment-id]:last-child [data-meeting-commitment-title]')?.focus();
      });
      document.querySelectorAll('[data-add-calendar-block]').forEach((button) => button.addEventListener('click', () => addCalendarBlock(Number(button.dataset.addCalendarBlock))));
      document.getElementById('link-existing-task-event').addEventListener('click', () => openCalendarPicker({ taskId: state.editingTaskId, meeting: false }));
      document.getElementById('search-calendar-events').addEventListener('click', loadExistingCalendarEvents);
      document.getElementById('calendar-event-query').addEventListener('keydown', (event) => { if (event.key === 'Enter') { event.preventDefault(); loadExistingCalendarEvents(); } });
      document.getElementById('close-calendar-picker').addEventListener('click', closeCalendarPicker);
      document.getElementById('new-project-button').addEventListener('click', openCreateModal);
      document.getElementById('close-project-modal').addEventListener('click', closeCreateModal);
      document.getElementById('cancel-project').addEventListener('click', closeCreateModal);
      document.getElementById('close-task-modal').addEventListener('click', closeTaskModal);
      document.getElementById('cancel-task-edit').addEventListener('click', closeTaskModal);
      document.getElementById('delete-task').addEventListener('click', deleteCurrentTask);
      document.getElementById('close-project-share').addEventListener('click', closeProjectShareModal);
      document.getElementById('done-project-share').addEventListener('click', closeProjectShareModal);
      document.getElementById('copy-project-share').addEventListener('click', copyProjectShareLink);
      document.getElementById('revoke-project-share').addEventListener('click', revokeProjectShareLink);
      document.getElementById('manage-departments-button').addEventListener('click', openDepartmentsModal);
      document.getElementById('close-departments-modal').addEventListener('click', closeDepartmentsModal);
      document.getElementById('done-departments-modal').addEventListener('click', closeDepartmentsModal);
      document.getElementById('create-department-form').addEventListener('submit', createDepartment);
      document.getElementById('projects-logout').addEventListener('click', logoutProjects);
      document.getElementById('refresh-projects').addEventListener('click', refreshProjectsAndDrive);
      document.getElementById('sidebar-toggle').addEventListener('click', () => applySidebarState(!document.getElementById('projects-app').classList.contains('sidebar-collapsed')));
      document.getElementById('mobile-menu').addEventListener('click', () => document.getElementById('projects-app').classList.toggle('sidebar-open'));
      document.querySelectorAll('.pm-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.pm-tab').forEach((item) => item.classList.toggle('is-active', item === tab));
          document.querySelectorAll('[data-panel]').forEach((panel) => panel.classList.toggle('pm-hidden', panel.dataset.panel !== tab.dataset.tab));
        });
      });
      document.getElementById('project-modal').addEventListener('click', (event) => {
        if (event.target.id === 'project-modal') closeCreateModal();
      });
      document.getElementById('task-modal').addEventListener('click', (event) => {
        if (event.target.id === 'task-modal') closeTaskModal();
      });
      document.getElementById('project-share-modal').addEventListener('click', (event) => {
        if (event.target.id === 'project-share-modal') closeProjectShareModal();
      });
      document.getElementById('departments-modal').addEventListener('click', (event) => {
        if (event.target.id === 'departments-modal') closeDepartmentsModal();
      });
      document.addEventListener('click', (event) => {
        if (!event.target.closest('.pm-select')) closeCustomSelects();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeCustomSelects();
      });

      document.addEventListener('DOMContentLoaded', async () => {
        document.querySelectorAll('select.pm-input').forEach(enhanceSelect);
        applySidebarState(localStorage.getItem('rasikaProjectsSidebarCollapsed') === 'true');
        renderMetrics();
        renderProjectList();
        renderWorkspace();
        if (currentToken()) {
          showProjectsApp();
          await loadProjects();
        } else {
          showProjectsLogin();
        }
      });
    </script>
  </body>
</html>
