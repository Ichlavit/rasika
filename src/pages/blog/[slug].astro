---
import "../../styles/global.css";
import Chatbot from "../../components/Chatbot.astro";
import SiteAnalytics from "../../components/SiteAnalytics.astro";
import SEO from "../../components/SEO.astro";
import {
  articlePath,
  articleWordCount,
  getPublishedBlogPosts,
  type PublishedBlogPost,
} from "../../lib/blog";
import { SITE, absoluteUrl, type SeoPage } from "../../data/seo";

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: PublishedBlogPost };
const path = articlePath(post.slug);
const articleUrl = absoluteUrl(path);
const imageUrl = absoluteUrl(post.cover_image || SITE.defaultImage);
const isRadar = post.type === "agent";
const publishedDate = new Date(post.published_at);
const modifiedDate = new Date(post.updated_at || post.published_at);
const displayDate = publishedDate.toLocaleDateString("es-CL", { day: "numeric", month: "long", year: "numeric" });
const articleTypeLabel = isRadar ? "Radar de tendencias en EdTech" : post.category || "Rasika Insights";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${articleUrl}#article`,
  mainEntityOfPage: articleUrl,
  headline: post.title,
  description: post.excerpt,
  image: [imageUrl],
  datePublished: publishedDate.toISOString(),
  dateModified: modifiedDate.toISOString(),
  articleSection: articleTypeLabel,
  wordCount: articleWordCount(post.content_html),
  inLanguage: SITE.language,
  author: isRadar
    ? { "@type": "Organization", name: "Rasika AI Radar", url: absoluteUrl("/blog/") }
    : { "@type": "Person", name: post.author },
  publisher: { "@id": absoluteUrl("/#organization") },
  isPartOf: { "@type": "Blog", "@id": absoluteUrl("/blog/#blog"), name: "Rasika Insights" },
  ...(post.source_url ? { citation: post.source_url } : {}),
};

const seo: SeoPage = {
  title: `${post.title} | Rasika Insights`,
  description: post.excerpt,
  path,
  image: post.cover_image || SITE.defaultImage,
  type: "article",
  topic: articleTypeLabel,
  keywords: [articleTypeLabel, "EdTech", "aprendizaje digital", ...(isRadar ? ["IA educativa", "tendencias EdTech"] : [])],
  jsonLd: [articleJsonLd],
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SEO {...seo} />
    <link rel="stylesheet" href="/article-content.css" />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
            colors: { rasika: { accent: '#5EA6B0', dark: '#141619', surface: '#1E2226' } },
          },
        },
      };
    </script>
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root { color-scheme: dark; }
      html, body { min-height: 100%; margin: 0; background: #0a0c0e; color: #f8fafc; font-family: "Plus Jakarta Sans", system-ui, sans-serif; }
      body { overflow: hidden; }
      .coursementor-avatar-static { background: url('/images/svg/avatar_animated.svg') center / cover no-repeat; }
      #reader-hero-bg { background-position: center; background-size: cover; }
      .reader-hero-scrim { position: absolute; inset: 0; background: rgba(7, 9, 11, .22); }
      .reader-hero-fade { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(20, 22, 25, 0), #141619 100%); }
      .reader-backdrop { background-position: center; background-size: cover; filter: blur(14px); transform: scale(1.04); }
    </style>
  </head>
  <body>
    <main id="reader-modal" class="fixed inset-0 z-[200] flex items-center justify-center" aria-label="Artículo">
      <button class="reader-backdrop fixed inset-0 min-h-[100dvh] w-screen border-0" style={`background-image: linear-gradient(rgba(10, 12, 14, .84), rgba(10, 12, 14, .96)), url("${post.cover_image || SITE.defaultImage}")`} type="button" aria-label="Volver al Blog" onclick="closeSharedReader()"></button>
      <article id="reader-container" class="relative z-10 flex h-[100dvh] w-full max-w-5xl flex-col overflow-hidden bg-[#141619] shadow-2xl ring-1 ring-white/10 md:h-[90vh] md:rounded-[2rem]">
        <header class="relative z-20 flex shrink-0 items-center justify-between border-b border-white/5 bg-[#1E2226] p-4 md:px-8 md:py-5">
          <div class="flex min-w-0 flex-col gap-0.5" id="reader-category">
            <span class="text-sm font-bold text-gray-300" id="reader-category-label">{articleTypeLabel}</span>
            {isRadar && <span class="text-xs font-medium text-gray-500">(potenciado por IA)</span>}
          </div>
          <button onclick="closeSharedReader()" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/5 text-gray-400 transition-colors hover:bg-white/10 hover:text-white" type="button" aria-label="Volver al Blog"><i data-lucide="x" class="h-5 w-5"></i></button>
        </header>

        <div class="no-scrollbar relative flex-1 overflow-y-auto scroll-smooth" id="reader-scroll-area">
          <div id="reader-hero-bg" class="relative h-48 w-full transition-all duration-500 md:h-[24rem]" style={`background-image: linear-gradient(rgba(10, 12, 14, .1), rgba(10, 12, 14, .1)), url("${post.cover_image || SITE.defaultImage}")`}><div class="reader-hero-scrim"></div><div class="reader-hero-fade"></div></div>
          <div class="relative z-10 mx-auto max-w-3xl px-6 py-12 md:py-16">
            <h1 id="reader-title" class="mb-8 font-sans text-3xl font-extrabold leading-tight tracking-tight text-white md:text-5xl">{post.title}</h1>
            <div class="mb-10 flex items-center gap-4 border-b border-white/10 pb-8">
              <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full border border-white/10 bg-[#1E2226]"><i data-lucide={isRadar ? "radar" : "user"} class:list={["h-6 w-6", isRadar ? "text-rasika-accent" : "text-gray-400"]}></i></div>
              <div><div class="text-base font-bold text-white">{post.author}</div><div class="mt-1 text-sm text-gray-500">{displayDate} · {post.read_time || "5 min de lectura"}</div></div>
            </div>
            <div id="reader-body" class="article-content rasika-article-content text-left" set:html={post.content_html}></div>

            <section class="mt-16 flex flex-col border-t border-white/10 pt-6" aria-label="Compartir artículo">
              <div class="flex items-center gap-4 py-4">
                <button data-share-platform="facebook" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/5 transition-transform hover:-translate-y-1 hover:bg-[#1877F2]/20" type="button" aria-label="Facebook"><img src="/images/social/facebook.svg" alt="" class="h-4 w-4 object-contain" /></button>
                <button data-share-platform="twitter" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/5 transition-transform hover:-translate-y-1 hover:bg-white/20" type="button" aria-label="X"><img src="/images/social/x.svg" alt="" class="h-4 w-4 object-contain" /></button>
                <button data-share-platform="linkedin" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/5 transition-transform hover:-translate-y-1 hover:bg-[#0A66C2]/20" type="button" aria-label="LinkedIn"><img src="/images/social/linkedin.svg" alt="" class="h-4 w-4 object-contain" /></button>
                <button id="copy-article-link" class="ml-2 flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/5 text-gray-400 transition-transform hover:-translate-y-1 hover:bg-white/20 hover:text-white" type="button" data-url={articleUrl} aria-label="Copiar enlace"><i data-lucide="link" class="h-4 w-4"></i></button>
              </div>
              <div class="flex items-center justify-between border-t border-white/10 py-5"><span class="text-sm font-medium tracking-wide text-gray-400">{post.views || 0} visualizaciones</span><span class="flex items-center gap-2 text-gray-400"><span class="text-sm font-bold">{post.likes || 0}</span><i data-lucide="heart" class="h-5 w-5"></i></span></div>
            </section>

            <section class="mt-8 rounded-2xl border border-rasika-accent/20 bg-gradient-to-br from-rasika-accent/10 to-transparent p-8 text-center" aria-labelledby="article-mentor-title">
              <span role="img" aria-label="CourseMentor" class="coursementor-avatar-static mx-auto mb-4 block h-14 w-14 rounded-full border border-rasika-accent/40 bg-[#141619]"></span>
              <h2 id="article-mentor-title" class="mb-2 text-xl font-bold text-white">¿Cómo se conecta esto con tu desafío?</h2>
              <p class="mb-6 text-sm text-gray-400">CourseMentor puede conversar sobre este artículo, comprender tu desafío de aprendizaje y relacionarlo con soluciones concretas de Rasika.</p>
              <button id="article-mentor-button" class="inline-flex items-center gap-2 rounded-full bg-rasika-accent px-6 py-3 font-bold text-[#0a0b0d] transition-all hover:bg-[#88d6e0]" type="button"><span>Explorar con CourseMentor</span><i data-lucide="message-circle" class="h-4 w-4"></i></button>
            </section>
          </div>
        </div>
      </article>
    </main>

    <SiteAnalytics articleSlug={post.slug} />
    <Chatbot />

    <script is:inline define:vars={{ articleId: post.id, articleTitle: post.title, articleIsRadar: isRadar }}>
      if (window.lucide) window.lucide.createIcons();

      function setArticleContext() {
        if (!window.setMentorArticleContext) return;
        window.setMentorArticleContext({ id: articleId, title: articleTitle, isRadar: articleIsRadar });
      }

      function blogIndexUrl() { return document.documentElement.lang === "en" ? "/en/blog/" : "/blog/"; }
      window.closeSharedReader = function() { window.location.assign(blogIndexUrl()); };
      setArticleContext();
      document.addEventListener("DOMContentLoaded", setArticleContext);
      document.addEventListener("keydown", (event) => { if (event.key === "Escape") window.closeSharedReader(); });

      document.getElementById("article-mentor-button")?.addEventListener("click", () => {
        setArticleContext();
        window.mentorCustomGreetingHTML = document.documentElement.lang === "en"
          ? `I see you read our article **"${articleTitle}"**. Would you like to explore how these ideas could apply to a learning challenge in your organization?`
          : `Veo que leíste nuestro artículo **"${articleTitle}"**. ¿Te gustaría conversar sobre cómo llevar esas ideas a la realidad de tu empresa?`;
        window.mentorCustomGreetingText = window.mentorCustomGreetingHTML;
        document.getElementById("mentor-fab")?.click();
      });

      async function getShareableArticleUrl() {
        const canonical = document.querySelector('link[rel="canonical"]')?.href || window.location.href;
        const url = new URL(canonical);
        const referralCode = window.ensureMentorReferralCode ? await window.ensureMentorReferralCode() : window.mentorReferralCode;
        if (/^[A-Za-z0-9_-]{8}$/.test(referralCode || "")) url.searchParams.set("ref", referralCode);
        return url.toString();
      }

      document.querySelectorAll("[data-share-platform]").forEach((button) => {
        button.addEventListener("click", () => {
          const popup = window.open("about:blank", "_blank");
          if (popup) popup.opener = null;
          void (async () => {
            const url = encodeURIComponent(await getShareableArticleUrl());
            const title = encodeURIComponent(articleTitle);
            const platform = button.dataset.sharePlatform;
            const destination = platform === "linkedin"
              ? `https://www.linkedin.com/shareArticle?mini=true&url=${url}&title=${title}`
              : platform === "twitter"
                ? `https://twitter.com/intent/tweet?url=${url}&text=${title}`
                : `https://www.facebook.com/sharer/sharer.php?u=${url}`;
            if (popup) popup.location.replace(destination); else window.location.assign(destination);
          })();
        });
      });

      document.getElementById("copy-article-link")?.addEventListener("click", async (event) => {
        const button = event.currentTarget;
        const icon = button.querySelector("i");
        try { await navigator.clipboard.writeText(await getShareableArticleUrl()); icon?.setAttribute("data-lucide", "check"); }
        catch { icon?.setAttribute("data-lucide", "x"); }
        if (window.lucide) window.lucide.createIcons();
        window.setTimeout(() => { if (icon) icon.setAttribute("data-lucide", "link"); if (window.lucide) window.lucide.createIcons(); }, 1800);
      });
    </script>
  </body>
</html>
