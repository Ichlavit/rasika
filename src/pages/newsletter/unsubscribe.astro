---
import '../../styles/global.css';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Suscripción | Rasika Producciones</title>
    <meta name="description" content="Gestiona tu suscripción al newsletter de Rasika." />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-[#0a0c0e] text-gray-200 font-sans flex items-center justify-center p-6">
    <main class="w-full max-w-xl border border-white/10 bg-[#1E2226] p-8 md:p-10 rounded-lg">
      <a href="/" class="block w-40 mb-10">
        <img src="/images/svg/rasika_logo.svg" alt="Rasika Producciones" class="w-full h-auto" />
      </a>
      <p class="text-xs font-bold uppercase text-[#88d6e0] mb-3">Rasika Insights</p>
      <h1 id="unsubscribe-title" class="text-3xl font-extrabold text-white mb-4">Cancelar suscripción</h1>
      <p id="unsubscribe-status" class="text-gray-400 leading-relaxed" role="status" aria-live="polite">Procesando tu solicitud…</p>
      <form id="unsubscribe-feedback" class="hidden mt-7 pt-7 border-t border-white/10">
        <fieldset>
          <legend class="text-sm font-bold text-white mb-3">¿Quieres contarnos por qué te vas?</legend>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-gray-300">
            <label class="flex items-center gap-2 rounded-lg border border-white/10 px-3 py-2.5 cursor-pointer hover:border-[#5EA6B0]/50"><input type="radio" name="reason" value="too_frequent" class="accent-[#5EA6B0]" /> Recibía demasiados correos</label>
            <label class="flex items-center gap-2 rounded-lg border border-white/10 px-3 py-2.5 cursor-pointer hover:border-[#5EA6B0]/50"><input type="radio" name="reason" value="not_relevant" class="accent-[#5EA6B0]" /> No era relevante para mí</label>
            <label class="flex items-center gap-2 rounded-lg border border-white/10 px-3 py-2.5 cursor-pointer hover:border-[#5EA6B0]/50"><input type="radio" name="reason" value="not_requested" class="accent-[#5EA6B0]" /> No recuerdo haberme suscrito</label>
            <label class="flex items-center gap-2 rounded-lg border border-white/10 px-3 py-2.5 cursor-pointer hover:border-[#5EA6B0]/50"><input type="radio" name="reason" value="other" class="accent-[#5EA6B0]" /> Otro motivo</label>
          </div>
        </fieldset>
        <label for="unsubscribe-comment" class="block text-sm font-bold text-white mt-5 mb-2">Comentario opcional</label>
        <textarea id="unsubscribe-comment" maxlength="1000" rows="4" class="w-full resize-y rounded-lg border border-white/10 bg-[#141619] p-3 text-sm text-white outline-none focus:border-[#5EA6B0]" placeholder="Tu comentario puede ayudarnos a mejorar."></textarea>
        <button id="unsubscribe-feedback-submit" type="submit" class="inline-flex mt-4 px-5 py-3 rounded-lg border border-[#5EA6B0]/40 text-[#88d6e0] font-bold hover:bg-[#5EA6B0]/10 transition-colors">Enviar comentario</button>
        <p id="unsubscribe-feedback-status" class="mt-3 min-h-5 text-sm text-gray-400" role="status" aria-live="polite"></p>
      </form>
      <a href="/blog/" class="inline-flex mt-8 px-5 py-3 rounded-lg bg-[#5EA6B0] text-[#0a0c0e] font-bold hover:bg-[#88d6e0] transition-colors">Volver a Rasika Insights</a>
    </main>

    <div id="unsubscribe-config" class="hidden" data-url={supabaseUrl} data-key={supabaseAnonKey}></div>
    <script is:inline>
      (async () => {
        const status = document.getElementById('unsubscribe-status');
        const config = document.getElementById('unsubscribe-config');
        const params = new URLSearchParams(location.search);
        const token = params.get('token');
        const campaignKey = params.get('campaign') || '';
        const preview = params.get('preview') === '1';
        const url = config?.dataset.url?.replace(/\/$/, '');
        const key = config?.dataset.key;
        const title = document.getElementById('unsubscribe-title');
        const feedbackForm = document.getElementById('unsubscribe-feedback');
        if (preview) {
          title.textContent = 'Lamentamos verte partir';
          status.textContent = 'Esta es la vista de prueba de la página de cancelación. Ninguna suscripción fue modificada.';
          feedbackForm.classList.remove('hidden');
          return;
        }
        if (!token || !url || !key) {
          status.textContent = 'El enlace no es válido o está incompleto.';
          return;
        }
        try {
          const response = await fetch(`${url}/functions/v1/newsletter-subscribe`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              apikey: key,
              Authorization: `Bearer ${key}`,
            },
            body: JSON.stringify({ action: 'unsubscribe', token }),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || 'Unsubscribe failed');
          title.textContent = 'Lamentamos verte partir';
          status.textContent = 'Tu suscripción fue cancelada. No recibirás nuevos envíos de marketing.';
          feedbackForm.classList.remove('hidden');
        } catch {
          status.textContent = 'No pudimos procesar el enlace. La suscripción puede haber sido cancelada anteriormente.';
        }

        feedbackForm?.addEventListener('submit', async (event) => {
          event.preventDefault();
          const submit = document.getElementById('unsubscribe-feedback-submit');
          const feedbackStatus = document.getElementById('unsubscribe-feedback-status');
          const reason = feedbackForm.querySelector('[name="reason"]:checked')?.value || '';
          const feedback = document.getElementById('unsubscribe-comment')?.value?.trim() || '';
          submit.disabled = true;
          feedbackStatus.textContent = 'Enviando…';
          try {
            const response = await fetch(`${url}/functions/v1/newsletter-subscribe`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                apikey: key,
                Authorization: `Bearer ${key}`,
              },
              body: JSON.stringify({ action: 'feedback', token, campaign_key: campaignKey, reason_code: reason, feedback }),
            });
            if (!response.ok) throw new Error('Feedback failed');
            feedbackStatus.textContent = 'Gracias. Tu comentario fue recibido.';
            feedbackForm.querySelectorAll('input,textarea,button').forEach(element => { element.disabled = true; });
          } catch {
            feedbackStatus.textContent = 'No pudimos guardar el comentario. Tu cancelación sigue vigente.';
            submit.disabled = false;
          }
        });
      })();
    </script>
  </body>
</html>
